# Dépendances et builds
node_modules/
dist/
.turbo/
.astro/
.wrangler/
.expo/
*.tsbuildinfo

# Secrets : seuls les *.example sont versionnés
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Médias lourds (démos vidéo)
*.mp4
*.mov
# Sauf les scènes du voyage sur ordinateur (2560 × 1440, 20 Mo en tout) : le site les sert, et le
# déploiement part du dépôt (deploy-portfolio.yml). Sans elles, il se rabattrait sur les boucles WebP.
!apps/portfolio/public/voyage/*.mp4
# Et les démos des fiches (scripts/demo-videos.ts, 1280 × 800, 4 à 7 Mo chacune), pour la même raison.
!apps/portfolio/public/demos/*.mp4
# Les planches de vignettes des démos, pour les relire, restent en local, comme les enregistrements sources
# des montages (scripts/demo-montage.ts), trop lourds pour le dépôt.
scripts/.demo-sheets/
scripts/.demo-sources/

# Divers
.DS_Store
Thumbs.db
*.log
.claude/settings.local.json
