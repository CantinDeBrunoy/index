{
  "name": "hublot",
  "version": "1.0.0",
  "private": true,
  "description": "Alertes de bons plans sur billets d'avion aller-retour depuis Paris (Travelpayouts → ntfy).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-page.ts",
    "start": "node dist/main.js",
    "dry-run": "pnpm run build && node dist/main.js --dry-run",
    "typecheck": "tsc && tsc -p tsconfig.web.json && tsc -p worker",
    "test": "vitest run",
    "deploy:page": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "devDependencies": {
    "@index/auth": "workspace:*",
    "@index/projects": "workspace:*",
    "@index/ui": "workspace:*",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
