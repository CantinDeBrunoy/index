---
import { getProject } from "@index/projects";
import tokensCss from "@index/ui/tokens.css?raw";
import Entry from "../components/Entry.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { useTranslations } from "../i18n/ui";
import Base from "../layouts/Base.astro";

const t = useTranslations("fr");

// Les tokens sont lus directement dans @index/ui/tokens.css : la page reste à jour toute seule.
const rootBlock = /:root\s*{([\s\S]*?)}/.exec(tokensCss)?.[1] ?? "";
const tokens = [...rootBlock.matchAll(/--([\w-]+):\s*([^;]+);/g)].map(([, name, value]) => ({
  name: `--${name}`,
  value: value!.trim().replace(/\s+/g, " "),
}));
const group = (test: (name: string) => boolean) => tokens.filter((tok) => test(tok.name));

const colors = group((n) => /^--(black|white|gray|red)/.test(n));
const fonts = group((n) => n.startsWith("--font-"));
const sizes = group((n) => n.startsWith("--fs-"));
const typeDetails = group((n) => /^--(lh|tracking)-/.test(n));
const spaces = group((n) => n.startsWith("--space-") || n === "--gutter");
const lines = group((n) => /^--(border|radius|focus)/.test(n));
const motion = group((n) => /^--(dur|easing)/.test(n));

const usage: Record<string, string> = {
  "--black": "Fond des sections sombres, texte des sections claires.",
  "--white": "Fond des sections claires, texte des sections sombres.",
  "--gray-900": "Bordures discrètes sur noir ; texte secondaire sur blanc.",
  "--gray-500": "Texte secondaire sur noir ; bordures discrètes sur blanc.",
  "--red": "Accent sur fond noir uniquement. Un seul élément rouge par écran.",
  "--red-ink": "Accent sur fond blanc : #FF1A1A n'y passe pas le contraste AA en petit texte.",
};

const sample = getProject("magellan");
const states = ["pending", "online", "asleep", "offline", "unknown", "archive", "desktop"] as const;
---

<Base title="Charte graphique" description="Tokens et composants de la charte INDEX." noindex>
  <header class="sg-hero theme-dark">
    <nav class="sg-hero__crumbs label"><a href="/">← INDEX</a> <span class="muted">/ STYLEGUIDE</span></nav>
    <h1 class="display sg-hero__title" data-parallax data-parallax-hero style="--parallax: 0.4">Styleguide</h1>
    <p class="sg-hero__intro">
      Tokens et composants de la charte <span class="accent">INDEX</span> : brutalisme noir et blanc, un seul accent rouge.
      Source : <code>packages/ui/src/tokens.css</code>.
    </p>
  </header>

  <main id="contenu" tabindex="-1">
    <section class="section theme-light sg" aria-labelledby="sg-couleurs">
      <h2 id="sg-couleurs" class="sg__title display">Couleurs</h2>
      <ul class="swatches" role="list">
        {
          colors.map(({ name, value }) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${name})`} />
              <code class="label">{name}</code>
              <span class="label muted">{value}</span>
              <p>{usage[name]}</p>
            </li>
          ))
        }
      </ul>
      <div class="themes">
        <div class="theme-dark themes__item">
          <p class="label">.theme-dark</p>
          <p>Texte <span class="muted">secondaire</span> et <span class="accent">accent</span>.</p>
        </div>
        <div class="theme-light themes__item themes__item--light">
          <p class="label">.theme-light</p>
          <p>Texte <span class="muted">secondaire</span> et <span class="accent">accent</span>.</p>
        </div>
      </div>
    </section>

    <section class="section theme-dark sg" aria-labelledby="sg-typo">
      <h2 id="sg-typo" class="sg__title display">Typographie</h2>
      <dl class="token-list">
        {
          fonts.map(({ name, value }) => (
            <div>
              <dt class="label">{name}</dt>
              <dd style={`font-family: var(${name})`} class="font-sample">
                {name === "--font-display" ? "INDEX 005 MAGELLAN" : "005 · 2026 · EN LIGNE · expo, typescript"}
              </dd>
              <dd class="label muted">{value}</dd>
            </div>
          ))
        }
      </dl>
      <ol class="scale" role="list">
        {
          sizes.map(({ name, value }) => (
            <li>
              <span class="label muted">
                {name} · {value}
              </span>
              <span class="display scale__sample" style={`font-size: var(${name})`}>
                Index
              </span>
            </li>
          ))
        }
      </ol>
      <dl class="token-list">
        {
          typeDetails.map(({ name, value }) => (
            <div>
              <dt class="label">{name}</dt>
              <dd class="label muted">{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section theme-light sg" aria-labelledby="sg-grille">
      <h2 id="sg-grille" class="sg__title display">Espaces et bordures</h2>
      <ul class="spaces" role="list">
        {
          spaces.map(({ name, value }) => (
            <li>
              <span class="label">{name}</span>
              <span class="spaces__bar" style={`width: var(${name})`} />
              <span class="label muted">{value}</span>
            </li>
          ))
        }
      </ul>
      <ul class="borders" role="list">
        {
          lines.map(({ name, value }) => (
            <li>
              <span class="label">{name}</span>
              <span class="label muted">{value}</span>
            </li>
          ))
        }
      </ul>
      <p class="sg__note">
        Grille visible : bordures pleines de 2 à 3 px, aucun arrondi (<code>--radius: 0</code>), aucune ombre douce, aucun dégradé.
      </p>
    </section>

    <section class="section theme-dark sg" aria-labelledby="sg-composants">
      <h2 id="sg-composants" class="sg__title display">Composants</h2>

      <h3 class="label sg__sub">Tags de stack</h3>
      <ul class="tags" role="list">
        <li>Expo</li>
        <li>TypeScript</li>
        <li>Cloudflare Workers</li>
      </ul>

      <h3 class="label sg__sub">Actions</h3>
      <ul class="actions" role="list">
        <li><a class="action" href="#sg-composants">{t("entry.demo")} <span aria-hidden="true">↗</span></a></li>
        <li><a class="action" href="#sg-composants">{t("entry.code")} <span aria-hidden="true">↗</span></a></li>
        <li><span class="action" aria-disabled="true">{t("entry.noDemo")}</span></li>
      </ul>

      <h3 class="label sg__sub">Statut live</h3>
      <ul class="states" role="list">
        {
          states.map((state) => (
            <li>
              <span class="status" data-health={state}>
                {t(`status.${state}`)}
              </span>
              <code class="label muted">{state}</code>
            </li>
          ))
        }
      </ul>

      <h3 class="label sg__sub">Onglet « ← INDEX » des apps</h3>
      <p class="sg__note">
        Composant <code>@index/ui/index-bar</code> : un onglet fixe dans un coin, en Shadow DOM, masqué en PWA installée.
        Aperçu en direct en bas à gauche de cette page.
      </p>
    </section>

    {
      sample && (
        <section class="section theme-light sg sg--entry" aria-labelledby="sg-entree">
          <h2 id="sg-entree" class="sg__title display">Entrée</h2>
          <p class="sg__note">
            Survol ou focus clavier : inversion instantanée, numéro en rouge, capture en couleur.
          </p>
          <Entry project={sample} />
        </section>
      )
    }

    <section class="section theme-dark sg" aria-labelledby="sg-mouvement">
      <h2 id="sg-mouvement" class="sg__title display">Mouvement et focus</h2>
      <dl class="token-list">
        {
          motion.map(({ name, value }) => (
            <div>
              <dt class="label">{name}</dt>
              <dd class="label muted">{value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="rules" role="list">
        <li>Parallax « sec » : couches à vitesses différentes, mouvement linéaire, transform uniquement.</li>
        <li>CSS scroll-driven animations quand elles existent, sinon un repli requestAnimationFrame.</li>
        <li><code>prefers-reduced-motion: reduce</code> coupe tout le parallax.</li>
        <li>Transitions de 0 à 100 ms ; le survol des entrées est instantané.</li>
        <li>Focus clavier : contour plein de 4 px, décalé de 3 px. Essayez la touche Tab.</li>
      </ul>
      <p><a class="action" href="#sg-mouvement">Lien de démonstration du focus</a></p>
    </section>
  </main>

  <SiteFooter theme="light" />
</Base>

<script>
  import { mountIndexBar } from "@index/ui/index-bar";

  mountIndexBar({ href: "/", entry: "000", corner: "bottom-left" });
</script>

<style>
  main:focus {
    outline: none;
  }
  code {
    font-family: var(--font-mono);
  }

  .sg-hero {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-bottom: var(--space-8);
    overflow: clip;
  }
  .sg-hero__crumbs {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4) var(--gutter);
    border-bottom: var(--border) solid var(--line);
  }
  .sg-hero__crumbs a {
    text-decoration: none;
  }
  .sg-hero__title {
    padding-inline: var(--gutter);
    font-size: var(--fs-mega);
    white-space: nowrap;
  }
  .sg-hero__intro {
    max-width: 60ch;
    margin: 0;
    padding-inline: var(--gutter);
    font-size: var(--fs-m);
  }

  .sg {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .sg__title {
    font-size: var(--fs-xl);
  }
  .sg__sub {
    margin: var(--space-4) 0 0;
  }
  .sg__note {
    max-width: 60ch;
    margin: 0;
  }
  .sg--entry {
    padding-inline: 0;
  }
  .sg--entry .sg__title,
  .sg--entry .sg__note {
    padding-inline: var(--gutter);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border) solid var(--line);
    border-left: var(--border) solid var(--line);
  }
  .swatch {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-right: var(--border) solid var(--line);
    border-bottom: var(--border) solid var(--line);
  }
  .swatch__chip {
    height: 6rem;
    border: var(--border-thin) solid var(--line);
  }
  .swatch p {
    margin: 0;
  }

  .themes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border: var(--border) solid var(--line);
  }
  .themes__item {
    padding: var(--space-5);
  }
  .themes__item p {
    margin: 0 0 var(--space-2);
  }
  .themes__item--light {
    border-left: var(--border) solid var(--line);
  }

  .token-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .token-list dd {
    margin: var(--space-1) 0 0;
  }
  .font-sample {
    font-size: var(--fs-l);
    line-height: 1.1;
  }

  .scale {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border) solid var(--line);
  }
  .scale li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) 0;
    border-bottom: var(--border-thin) solid var(--line-soft);
    overflow: clip;
  }
  .scale__sample {
    white-space: nowrap;
  }

  .spaces,
  .borders,
  .states,
  .rules {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spaces li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) 14rem;
    align-items: center;
    gap: var(--space-4);
  }
  .spaces__bar {
    height: 1.25rem;
    background: var(--fg);
  }
  .borders li,
  .states li {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .rules li::before {
    content: "■ ";
  }
</style>
