---
import { GITHUB_URL, MONOREPO_URL } from "@index/projects";
import { langFromUrl, useTranslations } from "../i18n/ui";

interface Props {
  /** Thème de la bande : l'inverse de la section qui précède. */
  theme: "dark" | "light";
}

const { theme } = Astro.props;
const t = useTranslations(langFromUrl(Astro.url));
const EMAIL = "cantin.roquier@gmail.com";
---

<footer class:list={["section", "footer", `theme-${theme}`]}>
  <p class="footer__end display" aria-hidden="true">FIN</p>
  <div class="footer__grid">
    <section aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="label muted">{t("footer.contact")}</h2>
      <ul role="list">
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a href={GITHUB_URL}>GitHub <span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
    <section aria-labelledby="footer-index">
      <h2 id="footer-index" class="label muted">INDEX</h2>
      <ul role="list">
        <li><a href={MONOREPO_URL}>{t("footer.source")} <span aria-hidden="true">↗</span></a></li>
        <li><a href="/styleguide">{t("footer.styleguide")}</a></li>
      </ul>
    </section>
    <p class="label muted footer__note">{t("footer.status")}</p>
  </div>
  <p class="label footer__legal">© {new Date().getFullYear()} Cantin Roquier</p>
</footer>

<style>
  .footer {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-6);
  }
  .footer__end {
    font-size: var(--fs-xxl);
    color: transparent;
    -webkit-text-stroke: var(--border-thin) var(--fg);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6);
  }
  .footer ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-m);
  }
  .footer a {
    text-decoration-thickness: var(--border-thin);
    text-underline-offset: 0.25em;
  }
  .footer a:hover {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
  }
  .footer__note,
  .footer__legal {
    margin: 0;
  }
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.2fr);
      align-items: start;
    }
    .footer__note {
      justify-self: end;
      max-width: 32ch;
    }
  }
</style>
