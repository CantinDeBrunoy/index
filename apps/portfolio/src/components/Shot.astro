---
import type { Project } from "@index/projects";
import { Image } from "astro:assets";
import { getShot, type ShotVariant } from "../lib/shots";

interface Props {
  project: Project;
  variant?: ShotVariant;
  /** Texte alternatif ; vide quand l'image double un texte déjà présent (liste). */
  alt?: string;
  sizes: string;
  loading?: "lazy" | "eager";
  /** Vitesse de la couche parallax (négative : plus rapide que la page). */
  parallax?: number;
}

const { project, variant = "desktop", alt = "", sizes, loading = "lazy", parallax } = Astro.props;
const image = getShot(project.slug, variant);
const widths = variant === "mobile" ? [240, 390, 780] : [480, 800, 1200, 1600];
---

<div class:list={["shot", `shot--${variant}`, { "shot--empty": !image }]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        class="shot__img"
        data-parallax={parallax === undefined ? undefined : ""}
        style={parallax === undefined ? undefined : `--parallax: ${parallax}`}
      />
    ) : (
      <span class="shot__placeholder" aria-hidden="true">
        {project.number}
      </span>
    )
  }
</div>

<style>
  .shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: clip;
    background: var(--bg);
  }
  .shot--mobile {
    aspect-ratio: 9 / 19.5;
  }
  .shot__img {
    position: absolute;
    left: 0;
    /* Marge en haut et en bas : la couche peut glisser (parallax) sans laisser de vide. */
    top: -1.5rem;
    width: 100%;
    height: calc(100% + 3rem);
    object-fit: cover;
    object-position: top center;
    filter: grayscale(1);
  }
  .shot--empty {
    display: grid;
    place-items: center;
  }
  .shot__placeholder {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: var(--border-thin) var(--fg);
  }
</style>
