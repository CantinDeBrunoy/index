---
/**
 * Une fiche projet, une par escale du voyage. L'en-tête prend la couleur et la scène de l'escale : la vidéo
 * haute définition sur ordinateur, la boucle du téléphone sous 700 px, une image fixe en mouvement réduit.
 * Le reste est sur papier crème : la démo et, à côté, la carte d'embarquement (la pile, l'hébergeur ; son
 * talon, le statut), pourquoi je l'ai fabriqué, ce que ça fait, comment c'est fait, l'étagère (les projets
 * racontés ici), le pied de page, et tout en bas une bande, de la couleur de l'en-tête, qui reprend le voyage à
 * l'escale du projet. La démo tourne d'elle-même quand elle est à l'écran. À droite, le copilote, dans la tenue
 * de l'escale, y ramène aussi pendant la lecture ; au bas de la page, il va se poser dans cette bande.
 * Les textes viennent de la collection de contenu (src/content/projets) ; le décor et l'accroche, de
 * data/voyage.ts ; les liens, la pile et l'hébergeur, de @index/projects.
 */
import { getProject, GITHUB_URL } from "@index/projects";
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import { FICHE, FICHE_OF, nameOf } from "../../data/fiches";
import { appOf, fill, kindOf, STOP_TEXTS, STOPS, VOYAGE } from "../../data/voyage";
import { EMAIL, fichePath, ROUTES, typo, type Lang } from "../../i18n/voyage";
import Voyage from "../../layouts/Voyage.astro";
import { getShot } from "../../lib/shots";
import Badges from "./Badges.astro";
import BoardingPass from "./BoardingPass.astro";
import Colophon from "./Colophon.astro";
import FichePoints from "./FichePoints.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
  /** Le projet de l'escale (slug de @index/projects). */
  slug: string;
}

const { lang, slug } = Astro.props;
const f = FICHE[lang];
const i = STOPS.findIndex((s) => s.slug === slug);
const stop = STOPS[i];
const project = getProject(slug);
const entry = await getEntry("projets", `${lang}/${slug}`);
if (!stop || !project || !entry?.data.why) throw new Error(`Fiche incomplète : ${lang}/${slug}`);

const n = i + 1;
const text = STOP_TEXTS[lang][slug]!;
const { why, features, choices, capture, video } = entry.data;
const kind = kindOf(project, text, lang);
const app = appOf(project, text, lang);
const code = project.links.code;
const alternates = { fr: fichePath("fr", project), en: fichePath("en", project) };

// La vidéo de démo : son affiche est à côté d'elle (<slug>.webp), sa taille dans la fiche.
const demoPoster = (src: string) => src.replace(/\.mp4$/, ".webp");
// La capture : celle d'ordinateur, et sous 700 px celle du téléphone, s'il y en a une.
const shot = capture ? getShot(slug, "desktop") : undefined;
const shotPhone = capture ? getShot(slug, "mobile") : undefined;
const shotSet = shot && (await getImage({ src: shot, widths: [640, 1040, 1440], format: "webp" }));
const shotPhoneSet = shotPhone && (await getImage({ src: shotPhone, widths: [390, 780], format: "webp" }));
// Avec une vidéo ou une capture, la carte d'embarquement se pose à sa droite ; sans, elle reste seule sous la ligne de vol.
const media = Boolean(video || (capture && shot && shotSet));

// L'étagère : les projets sans fiche à eux, racontés sur celle-ci.
const shelf = await Promise.all(
  Object.entries(FICHE_OF)
    .filter(([, host]) => host === slug)
    .map(async ([shelved]) => {
      const p = getProject(shelved)!;
      const e = await getEntry("projets", `${lang}/${shelved}`);
      return { project: p, name: nameOf(p, lang), text: e?.data.shelf ?? "" };
    }),
);

const still = (scene: string, size = "") => `/voyage/stills/${scene}${size}.webp`;

// Le retour au voyage, à l'escale du projet : le copilote et le bouton du bas.
const resume = `${ROUTES.voyage[lang]}#escale-${n}`;
// Le copilote, dans la tenue de l'escale : sa boucle, et son image fixe en mouvement réduit.
const copilote = { loop: `/voyage/copilote/${stop.scene}.webp`, still: `/voyage/copilote/${stop.scene}-fixe.webp` };
// Les textes en prose, à la typographie de la langue (les espaces insécables du français).
const T = (text: string) => typo(lang, text);
---

<Voyage lang={lang} title={project.name} description={text.pitch} alternates={alternates} type="article" palette="day">
  <div class={`hero pal-${stop.palette}`} style={`--stop-bg: ${stop.bg}`}>
    <SiteHeader lang={lang} current="projets" exact={false} alternates={alternates} />

    <div class="wrap-read">
      <div class="hero__body">
        <div class="hero__text">
          <h1 class="serif">{project.name}</h1>
          <p class="hero__kind">
            <span>{kind.line}</span>
            <Badges project={project} lang={lang} />
          </p>
          <p class="hero__pitch">{T(text.pitch)}</p>
          <div class="hero__links">
            {"href" in app ? <a class="go" href={app.href} target={app.target} rel={app.rel}>{app.label}</a> : <span class="hero__note">{app.note}</span>}
            {
              code && (
                <a class="link" href={code} target="_blank" rel="noopener">
                  {VOYAGE[lang].code}
                </a>
              )
            }
          </div>
        </div>

        <div class="hero__scene" data-scene-video role="img" aria-label={text.alt}>
          <script is:inline>
            document.currentScript.parentElement.classList.add("js");
          </script>
          <video
            class="scene--video"
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="none"
            poster={still(stop.scene)}
            aria-hidden="true"
          >
            <source src={`/voyage/${stop.scene}-av1.mp4`} type='video/mp4; codecs="av01.0.12M.08"' />
            <source src={`/voyage/${stop.scene}.mp4`} type='video/mp4; codecs="avc1.640034"' />
          </video>
          <picture>
            <source media="(max-width: 700px) and (prefers-reduced-motion: reduce)" srcset={still(stop.scene, "-mobile")} />
            <source media="(max-width: 700px)" srcset={still(stop.scene, "-mobile")} data-loop={`/voyage/${stop.scene}-mobile.webp`} />
            <source media="(prefers-reduced-motion: reduce)" srcset={still(stop.scene)} />
            <img class="scene--still" src={`/voyage/${stop.scene}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          </picture>
        </div>
      </div>
    </div>
  </div>

  <main id="contenu" class="wrap-read">
    {
      media && (
        <section class="pictures">
          <h2 class:list={["label", { "visually-hidden": video }]}>{video ? f.demo : f.pictures}</h2>
          <div class="pictures__row">
          <figure>
            {video ? (
              <video class="shot shot--video" src={video.src} poster={demoPoster(video.src)} controls muted loop playsinline preload="none" width={video.width} height={video.height} data-demo />
            ) : (
            shot && shotSet && capture && <picture>
              {shotPhone && shotPhoneSet && (
                <source
                  media="(max-width: 700px)"
                  srcset={shotPhoneSet.srcSet.attribute}
                  sizes="300px"
                  width={shotPhone.width}
                  height={shotPhone.height}
                  type="image/webp"
                />
              )}
              <source srcset={shotSet.srcSet.attribute} sizes="(min-width: 1140px) 1040px, calc(100vw - 40px)" type="image/webp" />
              <img class="shot" src={shotSet.src} width={shot.width} height={shot.height} alt={capture.alt} loading="lazy" decoding="async" />
            </picture>
            )}
            <figcaption>{T(video ? video.caption : (capture?.caption ?? ""))}</figcaption>
          </figure>
          <BoardingPass lang={lang} project={project} stop={stop} text={text} compact />
          </div>
        </section>
      )
    }
    <FichePoints
      id="points"
      aria={f.pointsAria}
      prev={f.prevPoint}
      next={f.nextPoint}
      groups={[
        { label: f.depart, points: [{ title: f.why, text: T(why) }] },
        { label: f.what, points: features.map((item) => ({ title: T(item.title), text: T(item.text) })) },
        { label: f.how, points: choices.map((item) => ({ title: T(item.title), text: T(item.text) })) },
      ]}
    />

    {
      !media && (
        <section class="boarding">
          <BoardingPass lang={lang} project={project} stop={stop} text={text} level={2} />
        </section>
      )
    }


    {
      shelf.length > 0 && (
        <section class="shelf">
          <h2 class="label">{f.shelf}</h2>
          <div class="shelf__list">
            {shelf.map((s) => (
              <article class="shelf__item" id={s.project.slug}>
                <h3 class="serif shelf__name">
                  {s.name}
                </h3>
                <p class="shelf__text">{T(s.text)}</p>
                <ul class="chips">{s.project.stack.map((tech) => <li class="chip">{tech}</li>)}</ul>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <div class="wrap-read">
    <footer class="foot" data-resume-from>
      <p>
        {T(fill(f.question, { name: project.name }))} <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <a class="pill" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
    </footer>
    <Colophon lang={lang} legal={false} />
  </div>

  <!-- Tout en bas, sous le pied de page, sur toute la largeur, de la couleur de l'en-tête : la bande entière est le
       bouton qui reprend le voyage. Le copilote vient se poser dans son rond. -->
  <a class={`reprendre pal-${stop.palette}`} href={resume} style={`--stop-bg: ${stop.bg}`}>
    <span class="reprendre__pad" data-resume-pad>
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={copilote.still} />
        <img src={copilote.loop} alt="" width="400" height="400" loading="lazy" decoding="async" />
      </picture>
    </span>
    <span class="reprendre__text"><b>{f.resume}</b><small>{f.stop} {n} · {text.place}</small></span>
    <span class="reprendre__arrow" aria-hidden="true">→</span>
  </a>

  <a class="resume" href={resume} data-resume>
    <span class="resume__bubble">
      <b>{f.copilot}</b>
      <small>{f.stop} {n} · {text.place} <span aria-hidden="true">→</span></small>
    </span>
    <span class="resume__dock" data-resume-dock>
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset={copilote.still} />
        <img src={copilote.loop} alt="" width="400" height="400" loading="lazy" decoding="async" />
      </picture>
    </span>
  </a>
</Voyage>

<script>
  import "../../scripts/scene-video";
  import "../../scripts/demo-video";
  import "../../scripts/resume-button";
</script>

<style>
  /* — L'en-tête : la couleur, la palette et la scène de l'escale — */
  .hero {
    background: var(--stop-bg);
    color: var(--ink);
  }
  /* Les petits textes de laiton et de gris sont posés sur le fond de l'escale, plus soutenu que les
     cartes : sur les fonds clairs, un laiton et un gris plus sombres, 4,5:1 au moins. De même sur la
     bande du bas, de la même couleur. */
  .hero.pal-day,
  .hero.pal-dusk,
  .reprendre.pal-day,
  .reprendre.pal-dusk {
    --brass-text: #684c22;
  }
  .hero.pal-day,
  .reprendre.pal-day {
    --muted: #5f5447;
  }

  .hero__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 48px;
    padding: 16px 0 72px;
  }
  .hero__text {
    display: flex;
    flex: 1 1 400px;
    flex-direction: column;
    gap: 16px;
  }
  /* Le copilote, qui suit la lecture dès le haut de la fiche : dans la tenue de l'escale, il dit « Reprends ton
     voyage », dans une bulle crème au liseré de laiton, comme à l'accueil du voyage. En bas à droite au départ ;
     quand on descend, il monte (--rise, de 0 à 1, posé par scripts/resume-button.ts) jusqu'au milieu de l'écran,
     et il y reste, dans la marge. Au bas de la page, il va se poser dans le rond de la bande du bas (le même
     script le fait voler). Visible même sans script. */
  .resume {
    position: fixed;
    right: 32px;
    bottom: 28px;
    z-index: 5;
    translate: 0 calc(var(--rise, 0) * (28px + 50% - 50vh));
    display: flex;
    align-items: center;
    gap: 16px;
    color: #241e18;
    text-decoration: none;
    transition:
      opacity 0.25s,
      visibility 0s;
  }
  /* Dès le pied de page, sa bulle s'efface ; quand le rond est à l'écran, sa pastille, cerclée de laiton, s'y
     envole d'un bond ; une fois posée, c'est le rond qui la montre. */
  .resume:global(.is-leaving) .resume__bubble {
    opacity: 0;
    pointer-events: none;
  }
  .resume:global(.is-flying) .resume__dock {
    box-shadow: 0 0 0 2px var(--brass);
  }
  .resume:global(.is-landed) {
    visibility: hidden;
  }
  /* En mouvement réduit, il ne vole pas : il s'efface d'un fondu, et le rond le montre déjà. */
  @media (prefers-reduced-motion: reduce) {
    .resume:global(.is-landed) {
      opacity: 0;
      transition:
        opacity 0.25s,
        visibility 0s linear 0.25s;
    }
  }
  .resume__bubble {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 22px 14px 20px;
    border: 2px solid var(--brass);
    border-radius: var(--radius-l);
    background: #fbf7f0;
    box-shadow: 0 12px 30px rgba(14, 16, 24, 0.22);
    transition:
      background 0.2s,
      opacity 0.25s;
  }
  /* La pointe, vers lui. */
  .resume__bubble::after {
    content: "";
    position: absolute;
    right: -10px;
    top: 50%;
    width: 16px;
    height: 16px;
    border-top: 2px solid var(--brass);
    border-right: 2px solid var(--brass);
    background: inherit;
    transform: translateY(-50%) rotate(45deg);
  }
  .resume:hover .resume__bubble {
    background: #fff;
  }
  .resume b {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
  }
  .resume small {
    color: #84652f;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* Sa pastille, cadrée comme au voyage. */
  .resume__dock {
    position: relative;
    flex: none;
    width: 76px;
    height: 76px;
    overflow: hidden;
    border: 1px solid #2b3040;
    border-radius: var(--radius-pill);
    background: #171a24;
    box-shadow: 0 0 0 4px rgba(23, 26, 36, 0.18);
    transition:
      border-color 0.2s,
      box-shadow 0.25s;
  }
  .resume:hover .resume__dock {
    border-color: var(--brass);
  }
  .resume__dock img,
  .reprendre__pad img {
    position: absolute;
    left: -24%;
    top: -12%;
    display: block;
    width: 161%;
    height: 161%;
    max-width: none;
  }
  /* Sur téléphone, il reste en bas, sous le pouce, sans cacher le texte au milieu de l'écran. */
  @media (max-width: 700px) {
    .resume {
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      gap: 12px;
      translate: none;
    }
    .resume__bubble {
      padding: 10px 16px 10px 14px;
    }
    .resume b {
      font-size: 21px;
    }
    .resume__dock {
      width: 62px;
      height: 62px;
    }
  }
  @media print {
    .resume {
      display: none;
    }
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(56px, 6.6vw, 96px);
    line-height: 0.95;
  }
  .hero__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .hero__pitch {
    max-width: 540px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    padding-top: 6px;
  }
  .hero__note {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* La scène : sur ordinateur, avec le script, la vidéo haute définition (la boucle WebP ne se télécharge
     alors pas) ; sans script, ou si la vidéo est illisible, la boucle. */
  .hero__scene {
    position: relative;
    flex: 1.6 1 560px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-l);
  }
  .hero__scene video,
  .hero__scene img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scene img {
    display: block;
  }
  .hero__scene .scene--video {
    display: none;
  }
  @media (min-width: 701px) {
    .hero__scene:global(.js) .scene--video {
      display: block;
    }
    .hero__scene:global(.js) .scene--still {
      display: none;
    }
    .hero__scene:global(.js.no-video) .scene--video {
      display: none;
    }
    .hero__scene:global(.js.no-video) .scene--still {
      display: block;
    }
  }

  /* — Le papier : les rubriques, séparées d'un filet — */
  .shelf .label {
    flex: 1 1 200px;
  }
  .pictures {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
  }

  /* La carte d'embarquement, seule sous la ligne de vol, quand la fiche n'a ni démo ni capture. */
  .boarding {
    display: flex;
    justify-content: center;
    padding: 64px 0;
    border-bottom: 1px solid var(--line);
  }

  /* La démo (ou la capture) sur les trois quarts ; la carte d'embarquement à sa droite, centrée sur la démo
     elle-même, pas sur sa légende : la démo et la légende occupent deux rangées (une sous-grille), la carte la
     première. Plus étroit, elle passe dessous. */
  .pictures__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(300px, 1fr);
    grid-template-rows: auto auto;
    gap: 14px 48px;
    margin-top: 28px;
  }
  .pictures__row :global(.pass) {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    justify-self: center;
  }
  /* Sans titre visible au-dessus (la vidéo de démo se passe de légende) : rien à décaler. */
  .visually-hidden + .pictures__row {
    margin-top: 0;
  }
  .pictures figure {
    display: grid;
    grid-column: 1;
    grid-row: 1 / span 2;
    grid-template-rows: subgrid;
    justify-items: start;
    margin: 0;
  }
  .pictures figure .shot {
    align-self: center;
  }
  @media (max-width: 1000px) {
    .pictures__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .pictures__row :global(.pass) {
      grid-column: 1;
      grid-row: 3;
      margin-top: 22px;
    }
    .pictures figure {
      justify-items: center;
    }
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    box-shadow: 0 18px 48px rgba(36, 30, 24, 0.12);
  }
  .pictures picture {
    display: contents;
  }
  .pictures figcaption {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .shelf {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 56px;
    padding: 48px 0;
    border-bottom: 1px solid var(--line);
  }
  .shelf__list {
    display: flex;
    flex: 3 1 560px;
    flex-direction: column;
    gap: 32px;
  }
  .shelf__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .shelf__name {
    margin: 0;
    font-size: 32px;
    line-height: 1.1;
  }
  .shelf__text {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  /* — Tout en bas, sous le pied de page, sur toute la largeur : la bande, de la couleur et de la palette de
     l'en-tête, est le bouton, son contenu au centre — */
  .reprendre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 136px;
    padding: 28px 20px;
    background: var(--stop-bg);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s;
  }
  .reprendre:hover {
    background: color-mix(in srgb, var(--stop-bg) 92%, var(--ink));
  }
  .reprendre:focus-visible {
    outline-offset: -6px;
  }
  /* Le rond où le copilote se pose : sa pastille, cerclée de laiton (sans script, il y est d'emblée). Tant qu'il
     vole (.is-empty, scripts/resume-button.ts), le rond l'attend, vide, avec le point de laiton des objets à
     cliquer du voyage ; il rebondit quand il s'y pose (.is-touchdown). */
  .reprendre__pad {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    box-shadow: 0 0 0 2px var(--brass);
  }
  .reprendre__pad:global(.is-empty) {
    border-color: transparent;
    background: var(--halo);
  }
  .reprendre__pad:global(.is-empty) picture {
    visibility: hidden;
  }
  .reprendre__pad:global(.is-empty)::after {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--brass);
  }
  /* Le rebond part de sa taille : il s'écrase un peu en se posant, puis se redresse. */
  .reprendre__pad:global(.is-touchdown) {
    animation: touchdown 0.4s ease-out;
  }
  @keyframes touchdown {
    35% {
      transform: scale(0.9);
    }
    70% {
      transform: scale(1.04);
    }
  }
  .reprendre__text {
