---
/**
 * Une fiche projet, une par escale du voyage. L'en-tête prend la couleur et la scène de l'escale : la vidéo
 * haute définition sur ordinateur, la boucle du téléphone sous 700 px, une image fixe en mouvement réduit.
 * Le reste est sur papier crème : pourquoi je l'ai fabriqué, ce que ça fait, comment c'est fait à côté de
 * la carte d'embarquement (d'Index vers le projet ; son talon ouvre l'app), les captures, l'étagère (les
 * projets racontés ici), puis l'escale suivante, qui reprend le voyage ; après la dernière, le carnet.
 * Les textes viennent de la collection de contenu (src/content/projets) ; le décor et l'accroche, de
 * data/voyage.ts ; les liens, la pile et l'hébergeur, de @index/projects.
 */
import { getProject, GITHUB_URL } from "@index/projects";
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import { FICHE, FICHE_OF, nameOf } from "../../data/fiches";
import { appOf, fill, kindOf, START, STOP_TEXTS, STOPS, VOYAGE } from "../../data/voyage";
import { EMAIL, fichePath, ROUTES, typo, type Lang } from "../../i18n/voyage";
import Voyage from "../../layouts/Voyage.astro";
import { getShot } from "../../lib/shots";
import Badges from "./Badges.astro";
import BoardingPass from "./BoardingPass.astro";
import Colophon from "./Colophon.astro";
import FichePoints from "./FichePoints.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
  /** Le projet de l'escale (slug de @index/projects). */
  slug: string;
}

const { lang, slug } = Astro.props;
const f = FICHE[lang];
const i = STOPS.findIndex((s) => s.slug === slug);
const stop = STOPS[i];
const project = getProject(slug);
const entry = await getEntry("projets", `${lang}/${slug}`);
if (!stop || !project || !entry?.data.why) throw new Error(`Fiche incomplète : ${lang}/${slug}`);

const n = i + 1;
const text = STOP_TEXTS[lang][slug]!;
const { why, features, choices, capture, video } = entry.data;
const kind = kindOf(project, text, lang);
const app = appOf(project, text, lang);
const code = project.links.code;
const alternates = { fr: fichePath("fr", project), en: fichePath("en", project) };

// La vidéo de démo : son affiche est à côté d'elle (<slug>.webp), sa taille dans la fiche.
const demoPoster = (src: string) => src.replace(/\.mp4$/, ".webp");
// La capture : celle d'ordinateur, et sous 700 px celle du téléphone, s'il y en a une.
const shot = capture ? getShot(slug, "desktop") : undefined;
const shotPhone = capture ? getShot(slug, "mobile") : undefined;
const shotSet = shot && (await getImage({ src: shot, widths: [640, 1040, 1440], format: "webp" }));
const shotPhoneSet = shotPhone && (await getImage({ src: shotPhone, widths: [390, 780], format: "webp" }));
// Avec une vidéo ou une capture, la carte d'embarquement se pose à sa droite, en petit ; sans, elle reste
// seule sous la ligne de vol.
const media = Boolean(video || (capture && shot && shotSet));

// L'étagère : les projets sans fiche à eux, racontés sur celle-ci.
const shelf = await Promise.all(
  Object.entries(FICHE_OF)
    .filter(([, host]) => host === slug)
    .map(async ([shelved]) => {
      const p = getProject(shelved)!;
      const e = await getEntry("projets", `${lang}/${shelved}`);
      return { project: p, name: nameOf(p, lang), text: e?.data.shelf ?? "" };
    }),
);

// L'escale suivante, qui reprend le voyage ; après la dernière, le carnet.
const after = STOPS[i + 1];
const next = after && { ...after, n: n + 1, project: getProject(after.slug)!, text: STOP_TEXTS[lang][after.slug]! };
const still = (scene: string, size = "") => `/voyage/stills/${scene}${size}.webp`;

// La bande des escales, sous l'en-tête : la fiche d'avant et celle d'après, dans l'ordre du voyage ;
// avant la première escale, le départ ; après la dernière, le carnet.
const before = STOPS[i - 1];
const cellOf = (s: (typeof STOPS)[number], k: number) => ({
  href: fichePath(lang, getProject(s.slug)!),
  label: `${f.stop} ${k}`,
  place: STOP_TEXTS[lang][s.slug]!.place as string | undefined,
  name: getProject(s.slug)!.name,
  scene: s.scene as string | undefined,
  bg: s.bg,
});
const prevCell = before ? cellOf(before, n - 1) : { href: ROUTES.voyage[lang], label: f.departLabel, place: undefined, name: f.depart, scene: START.scene, bg: START.bg };
const nextCell = after ? cellOf(after, n + 1) : { href: ROUTES.projets[lang], label: f.end, place: undefined, name: f.journal, scene: undefined, bg: "" };
const ARROW = { prev: "M19 12H5M11 18l-6-6 6-6", next: "M5 12h14M13 6l6 6-6 6" };
// Les textes en prose, à la typographie de la langue (les espaces insécables du français).
const T = (text: string) => typo(lang, text);
---

<Voyage lang={lang} title={project.name} description={text.pitch} alternates={alternates} type="article" palette="day">
  <div class={`hero pal-${stop.palette}`} style={`--stop-bg: ${stop.bg}`}>
    <SiteHeader lang={lang} current="projets" exact={false} alternates={alternates} />

    <div class="wrap-read">
      <div class="hero__body">
        <div class="hero__text">
          <h1 class="serif">{project.name}</h1>
          <p class="hero__kind">
            <span>{kind.line}</span>
            <Badges project={project} lang={lang} />
          </p>
          <p class="hero__pitch">{T(text.pitch)}</p>
          <div class="hero__links">
            {"href" in app ? <a class="go" href={app.href} target={app.target} rel={app.rel}>{app.label}</a> : <span class="hero__note">{app.note}</span>}
            {
              code && (
                <a class="link" href={code} target="_blank" rel="noopener">
                  {VOYAGE[lang].code}
                </a>
              )
            }
          </div>
        </div>

        <div class="hero__scene" data-scene-video role="img" aria-label={text.alt}>
          <script is:inline>
            document.currentScript.parentElement.classList.add("js");
          </script>
          <video
            class="scene--video"
            muted
            loop
            playsinline
            disablepictureinpicture
            preload="none"
            poster={still(stop.scene)}
            aria-hidden="true"
          >
            <source src={`/voyage/${stop.scene}-av1.mp4`} type='video/mp4; codecs="av01.0.12M.08"' />
            <source src={`/voyage/${stop.scene}.mp4`} type='video/mp4; codecs="avc1.640034"' />
          </video>
          <picture>
            <source media="(max-width: 700px) and (prefers-reduced-motion: reduce)" srcset={still(stop.scene, "-mobile")} />
            <source media="(max-width: 700px)" srcset={still(stop.scene, "-mobile")} data-loop={`/voyage/${stop.scene}-mobile.webp`} />
            <source media="(prefers-reduced-motion: reduce)" srcset={still(stop.scene)} />
            <img class="scene--still" src={`/voyage/${stop.scene}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          </picture>
        </div>
      </div>
    </div>
  </div>

  <nav class="strip" aria-label={f.stripAria}>
    {
      [["prev", prevCell], ["next", nextCell]].map(([side, c]) => {
        const cell = c as typeof prevCell;
        return (
          <a class:list={["strip__cell", `strip__${side}`]} href={cell.href} rel={side as string}>
            <svg class="strip__arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={ARROW[side as "prev" | "next"]} />
            </svg>
            {cell.scene && (
              <span class="strip__thumb" style={`background: ${cell.bg}`}>
                <img src={still(cell.scene, "-640")} alt="" width="640" height="360" loading="lazy" decoding="async" />
              </span>
            )}
            <span class="strip__text">
              <span class="strip__label">
                {cell.label}
                {cell.place && <span class="strip__place"> · {cell.place}</span>}
              </span>
              <span class="serif strip__name">{cell.name}</span>
            </span>
          </a>
        );
      })
    }
    <div class="strip__mid" aria-hidden="true">
      <span class="strip__label">{fill(f.stopOf, { i: n, n: STOPS.length })}</span>
      <span class="strip__dots">{STOPS.map((_, k) => <i class:list={[{ done: k < i, now: k === i }]} />)}</span>
    </div>
  </nav>

  <main id="contenu" class="wrap-read">
    {
      media && (
        <section class="pictures">
          <h2 class:list={["label", { "visually-hidden": video }]}>{video ? f.demo : f.pictures}</h2>
          <div class="pictures__row">
          <figure>
            {video ? (
              <video class="shot shot--video" src={video.src} poster={demoPoster(video.src)} controls muted playsinline preload="none" width={video.width} height={video.height} />
            ) : (
            shot && shotSet && capture && <picture>
              {shotPhone && shotPhoneSet && (
                <source
                  media="(max-width: 700px)"
                  srcset={shotPhoneSet.srcSet.attribute}
                  sizes="300px"
                  width={shotPhone.width}
                  height={shotPhone.height}
                  type="image/webp"
                />
              )}
              <source srcset={shotSet.srcSet.attribute} sizes="(min-width: 1140px) 1040px, calc(100vw - 40px)" type="image/webp" />
              <img class="shot" src={shotSet.src} width={shot.width} height={shot.height} alt={capture.alt} loading="lazy" decoding="async" />
            </picture>
            )}
            <figcaption>{T(video ? video.caption : (capture?.caption ?? ""))}</figcaption>
          </figure>
          <BoardingPass lang={lang} project={project} stop={stop} n={n} text={text} compact />
          </div>
        </section>
      )
    }
    <FichePoints
      id="points"
      aria={f.pointsAria}
      prev={f.prevPoint}
      next={f.nextPoint}
      groups={[
        { label: f.depart, points: [{ title: f.why, text: T(why), quote: true }] },
        { label: f.what, points: features.map((item) => ({ title: T(item.title), text: T(item.text) })) },
        { label: f.how, points: choices.map((item) => ({ title: T(item.title), text: T(item.text) })) },
      ]}
    />

    {
      !media && (
        <section class="boarding">
          <BoardingPass lang={lang} project={project} stop={stop} n={n} text={text} />
        </section>
      )
    }


    {
      shelf.length > 0 && (
        <section class="shelf">
          <h2 class="label">{f.shelf}</h2>
          <div class="shelf__list">
            {shelf.map((s) => (
              <article class="shelf__item" id={s.project.slug}>
                <h3 class="serif shelf__name">
                  {s.project.number} · {s.name}
                </h3>
                <p class="shelf__text">{T(s.text)}</p>
                <ul class="chips">{s.project.stack.map((tech) => <li class="chip">{tech}</li>)}</ul>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="next" data-resume-hides>
      {
        next ? (
          <a class="post next-card" href={`${ROUTES.voyage[lang]}#escale-${next.n}`}>
            <span class="thumb" style={`background: ${next.bg}`}>
              <img
                src={still(next.scene, "-640")}
                srcset={`${still(next.scene, "-640")} 640w, ${still(next.scene)} 1280w`}
                sizes="(min-width: 760px) 560px, 100vw"
                alt=""
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="next-card__text">
              <span class="next-card__label">{fill(f.next, { place: next.text.place })}</span>
              <span class="serif next-card__name">{next.project.name}</span>
              <span class="next-card__pitch">{T(next.text.pitch)}</span>
              <span class="link">{f.go}</span>
            </span>
          </a>
        ) : (
          <a class="post end-card" href={ROUTES.projets[lang]}>
            <span class="next-card__label">{f.end}</span>
            <span class="serif next-card__name">{f.journal}</span>
            <span class="link">{f.seeAll}</span>
          </a>
        )
      }
    </section>

    <footer class="foot" data-resume-hides>
      <p>
        {T(fill(f.question, { name: project.name }))} <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <a class="pill" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
    </footer>
    <Colophon lang={lang} />
  </main>

  <a class="resume pal-night" href={`${ROUTES.voyage[lang]}#escale-${n}`} data-resume>
    <span class="resume__thumb" style={`background: ${stop.bg}`}>
      <img src={still(stop.scene, "-640")} alt="" width="640" height="360" loading="lazy" decoding="async" />
    </span>
    <span class="resume__text"><b>{f.resume}</b><small>{f.stop} {n} · {text.place}</small></span>
  </a>
</Voyage>

<script>
  import "../../scripts/scene-video";
  import "../../scripts/resume-button";
</script>

<style>
  /* — L'en-tête : la couleur, la palette et la scène de l'escale — */
  .hero {
    background: var(--stop-bg);
    color: var(--ink);
  }
  /* Les petits textes de laiton et de gris sont posés sur le fond de l'escale, plus soutenu que les
     cartes : sur les fonds clairs, un laiton et un gris plus sombres, 4,5:1 au moins. */
  .hero.pal-day,
  .hero.pal-dusk {
    --brass-text: #684c22;
  }
  .hero.pal-day {
    --muted: #5f5447;
  }

  .hero__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 48px;
    padding: 16px 0 72px;
  }
  .hero__text {
    display: flex;
    flex: 1 1 400px;
    flex-direction: column;
    gap: 16px;
  }
  .strip__thumb {
    flex: none;
    overflow: hidden;
    border-radius: var(--radius-pill);
  }
  .strip__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .strip__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  /* Le retour au voyage, qui suit la lecture dès le haut de la fiche : de nuit, en bas à droite ; sur
     téléphone, en bas, de toute la largeur. Visible même sans script ; scripts/resume-button.ts l'efface au
     bas de la page. */
  .resume {
    position: fixed;
    right: 32px;
    bottom: 32px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 8px 28px 8px 8px;
    border: 1.5px solid var(--brass);
    border-radius: var(--radius-pill);
    background: var(--night);
    box-shadow: 0 14px 36px rgba(14, 16, 24, 0.35);
    color: var(--ink);
    text-decoration: none;
    transition:
      opacity 0.25s,
      transform 0.25s,
      visibility 0s,
      background 0.2s;
  }
  .resume:global(.is-hidden) {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 0.25s,
      transform 0.25s,
      visibility 0s linear 0.25s,
      background 0.2s;
  }
  .resume:hover {
    background: var(--card);
  }
  .resume__thumb {
    flex: none;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 2px var(--brass);
  }
  .resume__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .resume__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .resume b {
    font-size: 16px;
    font-weight: 500;
  }
  .resume small {
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .resume {
      transform: none;
    }
  }
  @media (max-width: 700px) {
    .resume {
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom));
      left: 16px;
    }
  }
  @media print {
    .resume {
      display: none;
    }
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(56px, 6.6vw, 96px);
    line-height: 0.95;
  }
  .hero__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .hero__pitch {
    max-width: 540px;
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    padding-top: 6px;
  }
  .hero__note {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* La scène : sur ordinateur, avec le script, la vidéo haute définition (la boucle WebP ne se télécharge
     alors pas) ; sans script, ou si la vidéo est illisible, la boucle. */
  .hero__scene {
    position: relative;
    flex: 1.6 1 560px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-l);
  }
  .hero__scene video,
  .hero__scene img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scene img {
    display: block;
  }
  .hero__scene .scene--video {
    display: none;
  }
  @media (min-width: 701px) {
    .hero__scene:global(.js) .scene--video {
      display: block;
    }
    .hero__scene:global(.js) .scene--still {
      display: none;
    }
    .hero__scene:global(.js.no-video) .scene--video {
      display: none;
    }
    .hero__scene:global(.js.no-video) .scene--still {
      display: block;
    }
  }

  /* — La bande des escales, sous l'en-tête : celle d'avant, où on en est, celle d'après — */
  .strip {
    display: grid;
    grid-template-areas: "prev mid next";
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
    background: var(--card);
  }
  .strip__cell {
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 120px;
    padding: 22px clamp(20px, 4vw, 48px);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s;
  }
  .strip__cell:hover {
    background: color-mix(in srgb, var(--brass) 10%, var(--card));
  }
  .strip__prev {
    grid-area: prev;
  }
  .strip__next {
    grid-area: next;
    flex-direction: row-reverse;
    text-align: right;
  }
  .strip__arrow {
    flex: none;
    color: var(--brass-text);
    transition: transform 0.2s;
  }
  .strip__prev:hover .strip__arrow {
    transform: translateX(-4px);
  }
  .strip__next:hover .strip__arrow {
    transform: translateX(4px);
  }
  .strip__thumb {
    width: 72px;
    height: 72px;
  }
  .strip__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .strip__name {
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.05;
  }
  .strip__mid {
    grid-area: mid;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 40px;
    border-inline: 1px solid var(--line);
  }
  .strip__dots {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .strip__dots i {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--muted);
    border-radius: var(--radius-pill);
    box-sizing: border-box;
  }
  .strip__dots i.done,
  .strip__dots i.now {
    border-color: var(--brass);
    background: var(--brass);
  }
  .strip__dots i.now {
    width: 13px;
    height: 13px;
  }

  /* — Le papier : les rubriques, séparées d'un filet — */
  .shelf .label {
    flex: 1 1 200px;
  }
  .pictures {
    padding: 56px 0;
    border-bottom: 1px solid var(--line);
  }

  /* La carte d'embarquement, seule sous la ligne de vol. */
  .boarding {
    display: flex;
    justify-content: center;
    padding: 64px 0;
    border-bottom: 1px solid var(--line);
  }

  /* La démo (ou la capture) sur les trois quarts ; la carte d'embarquement, en petit, à sa droite. Plus
     étroit, la carte passe dessous. */
  .pictures__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(300px, 1fr);
    align-items: start;
    gap: 36px 48px;
    margin-top: 28px;
  }
  .pictures__row :global(.pass) {
    justify-self: center;
  }
  /* Sans titre visible au-dessus (la vidéo de démo se passe de légende) : rien à décaler. */
  .visually-hidden + .pictures__row {
    margin-top: 0;
  }
  .pictures figure {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin: 0;
  }
  @media (max-width: 1000px) {
    .pictures__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .pictures figure {
      align-items: center;
    }
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    box-shadow: 0 18px 48px rgba(36, 30, 24, 0.12);
  }
  .pictures picture {
    display: contents;
  }
  .pictures figcaption {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .shelf {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 56px;
    padding: 48px 0;
    border-bottom: 1px solid var(--line);
  }
  .shelf__list {
    display: flex;
    flex: 3 1 560px;
    flex-direction: column;
    gap: 32px;
  }
  .shelf__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
