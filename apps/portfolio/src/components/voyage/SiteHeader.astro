---
/**
 * L'en-tête des pages : la marque, et le sommaire (le seul bouton : les escales, les pages, la langue).
 * Sous 700 px, la marque réduite à « Index ».
 * Entre la marque et le sommaire, ce que la page y met.
 */
import { ROUTES, type Lang, type TabKey } from "../../i18n/voyage";
import Sommaire from "./Sommaire.astro";

interface Props {
  lang: Lang;
  /** La page du sommaire ; `exact` à faux pour une page qui en dépend (une fiche, sous « Les projets »). */
  current?: TabKey | undefined;
  exact?: boolean;
  /** Une fiche : son escale, que le sommaire montre comme celle où l'on en est. */
  here?: number | undefined;
  /** La même page dans chaque langue. */
  alternates: Record<Lang, string>;
}

const { lang, current, exact = true, here, alternates } = Astro.props;
---

<header class="site-header">
  <a class="brand" href={ROUTES.voyage[lang]}>
    <span class="brand__name">Index</span><span class="brand__who">Cantin Roquier</span>
  </a>
  <slot />
  <Sommaire lang={lang} alternates={alternates} here={here} current={current} exact={exact} />
</header>
