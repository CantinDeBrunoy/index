---
/**
 * L'en-tête des pages : la marque, les quatre onglets du site et l'interrupteur FR / EN.
 * Sous 700 px : la marque réduite à « Index », la langue et un menu ☰ (un <details>, sans script).
 * Entre la marque et les onglets, ce que la page y met (une fiche : ses escales en points).
 */
import { LANGS, ROUTES, STRINGS, TABS, type Lang, type TabKey } from "../../i18n/voyage";

interface Props {
  lang: Lang;
  /** L'onglet de la page ; `exact` à faux pour une page qui en dépend (une fiche, sous « Les projets »). */
  current?: TabKey | undefined;
  exact?: boolean;
  /** La même page dans chaque langue. */
  alternates: Record<Lang, string>;
}

const { lang, current, exact = true, alternates } = Astro.props;
const t = STRINGS[lang];
const currentOf = (key: TabKey) => (key === current ? (exact ? "page" : "true") : undefined);
---

<header class="site-header">
  <a class="brand" href={ROUTES.voyage[lang]}>
    <span class="brand__name">Index</span><span class="brand__who">Cantin Roquier</span>
  </a>
  <slot />
  <div class="nav-desktop">
    <nav aria-label={t.tabsAria} class="tabs">
      {TABS.map((key) => <a href={ROUTES[key][lang]} aria-current={currentOf(key)}>{t.tabs[key]}</a>)}
    </nav>
    <nav aria-label={t.langAria} class="tabs lang">
      {
        LANGS.map((l) => (
          <a href={alternates[l]} hreflang={l} lang={l} aria-label={t.langNames[l]} aria-current={l === lang ? "page" : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="nav-phone">
    <nav aria-label={t.langAria} class="tabs lang">
      {
        LANGS.map((l) => (
          <a href={alternates[l]} hreflang={l} lang={l} aria-label={t.langNames[l]} aria-current={l === lang ? "page" : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>
    <details class="m-menu">
      <summary aria-label={t.menu}>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </summary>
      <nav class="m-drop" aria-label={t.tabsAria}>
        {TABS.map((key) => <a href={ROUTES[key][lang]} aria-current={currentOf(key)}>{t.tabs[key]}</a>)}
      </nav>
    </details>
  </div>
</header>
