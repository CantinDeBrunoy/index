---
/**
 * « À propos », le passeport. L'en-tête de nuit, comme le départ et le carnet : le passeport ouvert sur le
 * bureau, que le tampon de laiton vise ; dessous, quatre chiffres. Puis, sur papier crème : l'itinéraire en plan
 * de ligne (la ligne de l'école, celle de la STIME, la correspondance du diplôme) et le détail des deux lignes,
 * les langues en pastilles de ligne et le sac en lignes de bus, puis un carrousel de ce qui se passe en dehors
 * du code, qui tourne seul (scripts/apropos-carousel.ts). Les textes et le plan : data/apropos.ts.
 * Les objets tournent en boucle sur ordinateur ; sur téléphone et en mouvement réduit, leur image fixe.
 */
import { getProject, GITHUB_URL } from "@index/projects";
import { APROPOS, AWAY, BAG_LINES, LANG_LINES, LINES, NOW, type LineId, type StationId } from "../../data/apropos";
import { fill } from "../../data/voyage";
import { EMAIL, fichePath, ROUTES, STRINGS, typo, type Lang } from "../../i18n/voyage";
import Voyage from "../../layouts/Voyage.astro";
import Colophon from "./Colophon.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = APROPOS[lang];
const R = a.route;
const alternates = { fr: ROUTES.apropos.fr, en: ROUTES.apropos.en };
const T = (text: string) => typo(lang, text);

// Le plan de ligne : chaque date en % de l'axe, les étiquettes placées pour ne pas se chevaucher.
const [from, to] = LINES.axis;
const years = Array.from({ length: to - from }, (_, k) => from + k);
const pct = (v: number) => +(((v - from) / (to - from)) * 100).toFixed(3);
const INK: Record<LineId, string> = { school: "#346885", work: "var(--brass)", branch: "#c0612b" };
type Place = "below" | "shift" | "right" | "left";
const PLACE: Partial<Record<StationId, Place>> = { ingenieur: "shift", fullstack: "shift", mobile: "left" };
const stops = [
  ...LINES.school.map((s) => ({ ...s, line: "school" as const })),
  ...LINES.work.map((s) => ({ ...s, line: "work" as const })),
].map((s) => ({ ...s, x: pct(s.at), place: PLACE[s.id] ?? "below", label: R.stations[s.id] }));
const today = pct(NOW);

const legs = [R.school, R.work];
const langs = LANG_LINES.map((l, k) => ({ ...l, ...a.langs[k]! }));
const away = AWAY.map((object, k) => ({ object, ...a.away[k]! }));
const still = (name: string) => `/voyage/stills/${name}.webp`;
---

<Voyage lang={lang} title={a.pageTitle} description={a.description} alternates={alternates} palette="day">
  <div class="hero pal-night">
    <SiteHeader lang={lang} current="apropos" alternates={alternates} />
    <div class="wrap-read">
      <div class="hero__body">
        <div class="hero__text">
          <p class="label">{a.label}</p>
          <h1 class="serif">Cantin Roquier</h1>
          <p class="hero__who">{a.role}<br />{a.where}</p>
          <p class="hero__lead">{T(a.lead)}</p>
          <p class="hero__status"><span aria-hidden="true"></span>{a.status}</p>
          <div class="hero__links">
            <a class="go" href={`mailto:${EMAIL}`}>{a.write}</a>
            {
              a.cv && (
                <a class="pill" href={a.cv.href} download={a.cv.file}>
                  {a.cv.label}
                </a>
              )
            }
            <a class="link" href={a.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a class="link" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
          </div>
        </div>
        <picture class="hero__scene">
          <source media="(prefers-reduced-motion: reduce)" srcset={still("passeport")} />
          <img src="/voyage/passeport.webp" alt={a.alt} width="1280" height="720" decoding="async" />
        </picture>
      </div>
    </div>
    <ul class="stats wrap-read">
      {
        a.stats.map(([n, text]) => (
          <li>
            <span class="serif stats__n">{n}</span>
            <span class="stats__text">{T(text)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <main id="contenu" class="wrap-read">
    <section class="block route">
      <p class="label">{a.labels.route}</p>
      <h2 class="serif title">{a.titles.route}</h2>
      <!-- Le plan, sur grand écran : décoratif pour les lecteurs d'écran, le détail des deux lignes, dessous, dit tout. -->
      <div class="metro" aria-hidden="true">
        <span class="metro__code" style={`top: 190px; background: ${INK.school}`}>{R.codes[0]}</span>
        <span class="metro__code metro__code--work" style="top: 380px">{R.codes[1]}</span>
        <div class="metro__plan">
          <i class="metro__band" style={`left: ${pct(LINES.band.from)}%; width: ${pct(LINES.band.to) - pct(LINES.band.from)}%`}></i>
          <span class="metro__band-label" style={`left: ${pct(LINES.band.from)}%`}>{R.band}</span>
          <i class="metro__line" style={`top: 190px; left: ${pct(LINES.school[0].at)}%; width: ${pct(LINES.interchange) - pct(LINES.school[0].at)}%; background: ${INK.school}`}></i>
          <i class="metro__line" style={`top: 380px; left: ${pct(LINES.work[0].at)}%; width: ${today - pct(LINES.work[0].at)}%; background: ${INK.work}`}></i>
          <i class="metro__arrow" style={`left: ${today}%`}></i>
          <i class="metro__branch" style={`left: ${pct(LINES.branch)}%`}></i>
          <i class="metro__stop" style={`top: 90px; left: ${pct(LINES.branch)}%; --c: ${INK.branch}`}></i>
          <span class="metro__label metro__label--right" style={`top: 60px; left: ${pct(LINES.branch)}%`}>
            <b>{R.stations.espagne[0]}</b><small>{R.stations.espagne[1]}</small>
          </span>
          <i class="metro__interchange" style={`left: ${pct(LINES.interchange)}%`}></i>
          <span class="metro__label metro__label--right" style={`top: 176px; left: ${pct(LINES.interchange)}%`}>
            <b>{R.stations.diplome[0]}</b><small>{R.stations.diplome[1]}</small>
          </span>
          {
            stops.map((s) => (
              <>
                <i
                  class:list={["metro__stop", { "metro__stop--today": s.id === "today" }]}
                  style={`top: ${s.line === "school" ? 190 : 380}px; left: ${s.x}%; --c: ${INK[s.line]}`}
                />
                <span class:list={["metro__label", `metro__label--${s.place}`]} style={`top: ${(s.line === "school" ? 190 : 380) + 22}px; left: ${s.x}%`}>
                  <b>{s.label[0]}</b>
                  <small>{s.label[1]}</small>
                </span>
              </>
            ))
          }
          <i class="metro__axis"></i>
          {
            years.map((y) => (
              <span class="metro__year" style={`left: ${pct(y)}%`}>
                {y}
              </span>
            ))
          }
        </div>
      </div>

      <div class="legs">
        {
          legs.map((leg) => (
            <div>
              <h3 class="serif">{leg.title}</h3>
              <p class="legs__sub">{leg.sub}</p>
              <ol>
                {leg.items.map(([when, title, where, text, line]) => (
                  <li>
                    <i class="legs__dot" style={`background: ${INK[line]}`} />
                    <span class="legs__when">{when}</span>
                    <div>
                      <p class="legs__title">{title}</p>
                      {where && <p class="legs__where">{where}</p>}
                      {text && <p class="legs__text">{T(text)}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
      <p class="route__projects">
        {T(R.projects)} <a class="link" href={ROUTES.voyage[lang]}>{R.projectsLink}</a>
      </p>
    </section>

    <section class="block lines">
      <div>
        <p class="label">{a.labels.langs}</p>
        <h2 class="serif title">{a.titles.langs}</h2>
        <ul class="roundels">
          {
            langs.map((l) => (
              <li>
                <span class="serif roundel" style={`background: ${l.ink}`} aria-hidden="true">
                  {l.code}
                </span>
                <span>
                  <span class="serif roundel__name">{l.name}</span>
                  <span class="roundel__level">{l.level}</span>
                  {"fiche" in l && l.link && (
                    <a class="link" href={fichePath(lang, getProject(l.fiche)!)}>
                      {l.link}
                    </a>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">{a.labels.bag}</p>
        <h2 class="serif title">{a.titles.bag}</h2>
        <ol class="buses">
          {
            a.bag.map(([group, items], k) => (
              <li class="bus" style={`--c: ${BAG_LINES[k]}`}>
                <span class="bus__num" aria-hidden="true">
                  {k + 1}
                </span>
                <h3 class="serif bus__name">{group}</h3>
                <ul class="bus__stops">
                  {items.map((tool) => (
                    <li>
                      <i aria-hidden="true" />
                      <span>{tool}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="block away" aria-labelledby="away-title">
      <p class="label">{a.labels.away}</p>
      <h2 id="away-title" class="serif title">{a.titles.away}</h2>
      <div class="carousel" data-carousel>
        <script is:inline>document.currentScript.parentElement.classList.add("js");</script>
        <ul class="carousel__track">
          {
            away.map((o, k) => (
              <li class="slide" data-slide data-pos={k === 0 ? "0" : k === 1 ? "1" : "-1"} role="group" aria-label={fill(a.carousel.slide, { n: k + 1, count: away.length })}>
                <picture class="slide__img">
                  <source media="(prefers-reduced-motion: reduce)" srcset={still(o.object)} />
                  <source media="(max-width: 700px)" srcset={still(o.object)} />
                  <img src={`/voyage/${o.object}.webp`} alt={o.alt} width="560" height="560" loading="lazy" decoding="async" />
                </picture>
                <div class="slide__text">
                  <h3 class="serif">{o.title}</h3>
                  {o.text && <p>{T(o.text)}</p>}
                </div>
              </li>
            ))
          }
        </ul>
        <div class="carousel__nav">
          <button type="button" class="carousel__btn" data-step="-1" aria-label={a.carousel.prev}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
          </button>
          <span class="carousel__dots">
            {away.map((o, k) => <button type="button" data-dot aria-label={o.title} aria-current={k === 0 ? "true" : undefined} />)}
          </span>
          <button type="button" class="carousel__btn" data-step="1" aria-label={a.carousel.next}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
          <button type="button" class="carousel__btn carousel__pause" data-pause data-pause-label={a.carousel.pause} data-play-label={a.carousel.play} aria-label={a.carousel.pause}>
            <svg class="carousel__icon-pause" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
            <svg class="carousel__icon-play" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
          </button>
        </div>
      </div>
      <div class="tagline">
        <span class="tagline__label">{a.labels.also}</span>
        <ul class="chips">{a.also.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </section>

    <footer class="foot">
      <h2 class="serif" set:html={T(STRINGS[lang].nextIdea)} />
      <div class="foot__links">
        <a class="go" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="pill foot__pill" href={a.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="pill foot__pill" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </footer>
    <Colophon lang={lang} />
  </main>
</Voyage>

<script>
  import "../../scripts/apropos-carousel";
</script>

<style>
  /* — L'en-tête de nuit : qui je suis, et le passeport — */
  .hero {
    background: var(--night);
    color: var(--ink);
  }
  .hero__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 48px;
    padding: 24px 0 56px;
  }
  .hero__text {
    display: flex;
    flex: 1 1 400px;
    flex-direction: column;
    gap: 16px;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(56px, 6.6vw, 96px);
    line-height: 0.95;
  }
  .hero__who {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
  }
  .hero__lead {
    max-width: 540px;
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
  }
  .hero__status span {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--brass);
    box-shadow: 0 0 0 4px rgba(217, 180, 117, 0.2);
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    padding-top: 6px;
  }
  .hero__scene {
    flex: 1.6 1 560px;
  }
  .hero__scene img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-l);
  }

  /* Quatre chiffres, sous l'en-tête : une bande de nuit, séparée d'un filet. */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-block: 0;
    list-style: none;
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 40px 28px 48px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .stats li:last-child {
    border-right: 1px solid var(--line);
  }
  .stats__n {
    color: var(--brass-text);
    font-size: clamp(52px, 5.4vw, 76px);
    line-height: 0.9;
  }
  .stats__text {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  /* — Le papier : des rubriques séparées d'un filet, une étiquette puis un titre — */
  .block {
    padding: 72px 0;
    border-bottom: 1px solid var(--line);
  }
  .route {
    padding-top: 88px;
  }
  .title {
    margin: 10px 0 0;
    font-size: clamp(40px, 4.4vw, 56px);
    line-height: 1;
  }

  /* L'itinéraire en plan de ligne : la ligne de l'école (bleue) et celle de la STIME (laiton), côte à côte pendant
     l'alternance, la correspondance du diplôme, l'embranchement de l'Espagne. Les dates en % de l'axe. */
  .metro {
    position: relative;
    height: 600px;
    margin-top: 36px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
  }
  .metro__plan {
    position: absolute;
    inset: 0 120px 0 96px;
  }
  .metro__code {
    position: absolute;
    left: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -22px;
    border-radius: 999px;
    color: #fbf7f0;
    font-family: var(--font-serif);
    font-size: 24px;
  }
  .metro__code--work {
    background: var(--brass);
    color: var(--on-brass);
  }
  .metro__band {
    position: absolute;
    top: 150px;
    height: 270px;
    border: 1px dashed rgba(176, 138, 79, 0.45);
    border-radius: 22px;
    background: rgba(176, 138, 79, 0.08);
  }
  .metro__band-label {
    position: absolute;
    top: 277px;
    padding-left: 16px;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .metro__line {
    position: absolute;
    height: 12px;
    margin-top: -6px;
    border-radius: 999px;
  }
  .metro__arrow {
    position: absolute;
    top: 364px;
    margin-left: 22px;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    border-left: 22px solid var(--brass);
  }
  .metro__branch {
    position: absolute;
    top: 90px;
    width: 12px;
    height: 100px;
    margin-left: -6px;
    border-radius: 999px;
    background: #c0612b;
  }
  .metro__interchange {
    position: absolute;
    top: 170px;
    width: 40px;
    height: 230px;
    margin-left: -20px;
    border: 6px solid var(--ink);
    border-radius: 999px;
    background: var(--card);
  }
  .metro__stop {
    position: absolute;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    border: 5px solid var(--c);
    border-radius: 999px;
    background: var(--card);
  }
  .metro__stop--today {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-width: 6px;
    animation: today 2.4s ease-in-out infinite;
  }
  @keyframes today {
    50% {
      box-shadow: 0 0 0 12px rgba(176, 138, 79, 0.18);
    }
  }
  .metro__label {
    position: absolute;
    width: 150px;
    text-align: center;
    transform: translateX(-50%);
  }
  .metro__label b {
    display: block;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.05;
  }
  .metro__label small {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .metro__label--shift {
    transform: translateX(calc(-50% + 50px));
  }
  .metro__label--right {
    text-align: left;
    transform: translateX(28px);
  }
  .metro__label--left {
    text-align: right;
    transform: translateX(calc(-100% - 30px));
  }
  .metro__axis {
    position: absolute;
    top: 545px;
    right: -60px;
    left: -40px;
    border-top: 1px solid var(--line);
  }
  .metro__year {
    position: absolute;
    top: 556px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    transform: translateX(-50%);
  }

  /* Le détail des deux lignes, côte à côte : une puce à la couleur de la ligne, une ligne par étape. */
  .legs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 40px 56px;
    margin-top: 56px;
  }
  .legs h3 {
    margin: 0;
    font-size: 32px;
    line-height: 1.1;
  }
  .legs__sub,
  .legs__where {
    margin: 6px 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .legs__where {
    margin-top: 3px;
  }
  .legs ol {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .legs li {
    display: grid;
    grid-template-columns: 14px 104px minmax(0, 1fr);
    gap: 4px 14px;
  }
  .legs__dot {
    width: 14px;
    height: 14px;
    margin-top: 4px;
    border-radius: 4px;
  }
  .legs__when {
    padding-top: 2px;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .legs__title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }
  .legs__text {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .route__projects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
    margin: 40px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }

  /* Les langues en pastilles de ligne, le sac en lignes de bus. */
  .lines {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 56px 72px;
    align-items: start;
  }
  .roundels {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .roundels li {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .roundel {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 999px;
    color: #fbf7f0;
    font-size: 36px;
  }
  .roundel__name {
    display: block;
    font-size: 30px;
    line-height: 1;
  }
  .roundel__level {
    display: block;
    margin-top: 4px;
    color: var(--muted);
