---
/**
 * Le tuto du copilote, dans sa bulle d'accueil à l'escale 1 : les deux façons de visiter, le voyage (l'objet
 * entouré d'or) ou le détail des projets (la fiche, « Les projets »).
 * Ses textes sont à la taille d'une bulle compacte ; seul l'accueil sur grand écran les agrandit.
 */
import { COPILOTE } from "../../data/copilote";
import { ROUTES, typo, type Lang } from "../../i18n/voyage";

interface Props {
  lang: Lang;
  /** L'identifiant du titre, que la bulle désigne par aria-labelledby. */
  titleId: string;
}

const { lang, titleId } = Astro.props;
const c = COPILOTE[lang];
---

<!-- La croix et le bouton principal rangent l'accueil (et l'anneau bat plus fort). -->
<button type="button" class="x" aria-label={c.close} data-copilote-fermer>
  <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
    <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
  </svg>
</button>
<p class="who">{c.who}</p>
<p class="title" id={titleId}>{typo(lang, c.hello)}</p>
<p class="text">{typo(lang, c.intro)}</p>
<ul class="ways">
  <li>
    <span class="way-ic" aria-hidden="true"><span class="mini-ring"></span></span>
    <span>
      <b>{c.voyage}</b>
      <span class="d">{typo(lang, c.voyageText)}</span><span class="m">{typo(lang, c.voyageTextPhone)}</span>
    </span>
  </li>
  <li>
    <span class="way-ic" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 20 20">
        <rect x="3" y="4" width="14" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
        <path d="M6 8.5h8M6 11.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </span>
    <span>
      <b>{c.detail}</b>
      <span class="d">{typo(lang, c.detailText)}</span><span class="m">{typo(lang, c.detailTextPhone)}</span>
    </span>
  </li>
</ul>
<div class="actions">
  <button type="button" class="go" data-copilote-voyage>{c.go}</button>
  <a class="pill" href={ROUTES.projets[lang]}>{c.projects}</a>
</div>
<p class="lost">{typo(lang, c.lost)}</p>

<style>
  .x {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .x:hover {
    background: var(--line);
    color: var(--ink);
  }
  .who {
    margin: 0;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .title {
    margin: 0;
    padding-right: 36px;
    font-family: var(--font-serif);
    font-size: 30px;
    line-height: 1;
  }
  .text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .ways {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }
  .ways li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .ways b {
    color: var(--ink);
    font-weight: 600;
  }
  .way-ic {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--brass-text);
  }
  .mini-ring {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 16px;
    height: 16px;
    border: 2px solid var(--brass);
    border-radius: var(--radius-pill);
  }
  .mini-ring::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: var(--radius-pill);
    background: var(--brass);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    padding-top: 6px;
  }
  .actions .go {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }
  .lost {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .m {
    display: none;
  }

  /* Sa bulle rouverte depuis la pastille, sur ordinateur (components/voyage/Copilote.astro) : elle grandit avec
     l'écran comme l'affiche du cartel (--u vaut 1 px sur un écran de 1440 × 900). */
  @media (min-width: 701px) {
    :global(.help) .x {
      top: calc(10 * var(--u));
      right: calc(10 * var(--u));
      width: max(44px, calc(48 * var(--u)));
      height: max(44px, calc(48 * var(--u)));
    }
    :global(.help) .who {
      font-size: max(12px, calc(13 * var(--u)));
    }
    :global(.help) .title {
      padding-right: calc(40 * var(--u));
      font-size: max(30px, calc(44 * var(--u)));
    }
    :global(.help) .text {
      font-size: max(14px, calc(17 * var(--u)));
    }
    :global(.help) .ways {
      gap: calc(12 * var(--u));
    }
    :global(.help) .ways li {
      grid-template-columns: max(34px, calc(40 * var(--u))) minmax(0, 1fr);
      gap: calc(14 * var(--u));
      font-size: max(13px, calc(16 * var(--u)));
    }
    :global(.help) .way-ic {
      width: max(34px, calc(40 * var(--u)));
      height: max(34px, calc(40 * var(--u)));
    }
    :global(.help) .actions .go,
    :global(.help) .actions .pill {
      min-height: max(44px, calc(52 * var(--u)));
      font-size: max(14px, calc(16 * var(--u)));
    }
    :global(.help) .actions .go {
      padding: 0 max(20px, calc(24 * var(--u)));
    }
  }

  /* L'accueil sur un grand écran (sa bulle à côté de lui, components/voyage/CopiloteAccueil.astro) : plus grand. */
  @media (min-width: 1200px) and (min-height: 800px) {
    :global(.bulle) .title {
      font-size: 34px;
    }
    :global(.bulle) .text {
      font-size: 15px;
      line-height: 1.55;
    }
    :global(.bulle) .ways li {
      font-size: 14px;
    }
  }

  @media (max-width: 700px) {
    .actions .go {
      flex: 1;
    }
    /* Dans la bulle de la pastille, les deux boutons l'un sous l'autre, sur toute la largeur. */
    :global(.help) .actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }
    :global(.help) .actions .pill {
      justify-content: center;
    }
    .d {
      display: none;
    }
    .m {
      display: inline;
    }
  }
</style>
