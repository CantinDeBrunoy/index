---
/**
 * L'accueil du copilote, à la première escale : il arrive en flottant dans le coin libre, en combinaison
 * spatiale, et donne le tuto (les deux façons de visiter : le voyage, ou le détail des projets).
 * « Faire le voyage » ou la croix le rangent à côté du bouton retour. Il accueille à chaque départ (le
 * bouton « Décoller ») : scripts/copilote.ts décide de l'afficher. Caché, il ne télécharge rien.
 */
import type { Lang } from "../../i18n/voyage";
import CopiloteTuto from "./CopiloteTuto.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="accueil" data-copilote-accueil hidden>
  <div class="accueil__astro" aria-hidden="true">
    <picture>
      <source media="(prefers-reduced-motion: reduce)" srcset="/voyage/copilote/accueil-fixe.webp" />
      <img src="/voyage/copilote/accueil.webp" alt="" width="640" height="640" loading="lazy" decoding="async" />
    </picture>
  </div>
  <aside class="bulle" aria-labelledby="copilote-accueil-titre">
    <div class="bulle__peek" aria-hidden="true">
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset="/voyage/copilote/espace-fixe.webp" />
        <img src="/voyage/copilote/espace.webp" alt="" width="400" height="400" loading="lazy" decoding="async" />
      </picture>
    </div>
    <CopiloteTuto lang={lang} mode="accueil" titleId="copilote-accueil-titre" />
  </aside>
</div>

<style>
  /* Sur ordinateur : la bulle, puis lui, dans le coin bas droit, au-dessus du bouton retour. L'image touche
     le bord de l'écran : à l'escale 1, son cordon de laiton en sort. --a : la taille de l'image. */
  .accueil {
    --a: clamp(220px, 21vw, 340px);
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 110px;
    display: flex;
    align-items: flex-start;
    pointer-events: none;
  }
  .accueil[hidden] {
    display: none;
  }
  :global(.stop.leave) .accueil {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .accueil__astro {
    order: 2;
    flex: none;
    width: var(--a);
    height: var(--a);
    animation: astro-in 1.5s 1.1s cubic-bezier(0.2, 0.8, 0.25, 1) both;
  }
  .accueil__astro img,
  .bulle__peek img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* La bulle, comme celle de sa pastille : crème sur toutes les escales, épais liseré de laiton, et sa grosse
     pointe à droite, à hauteur du casque (au tiers de l'image). */
  .bulle {
    --card: #fbf7f0;
    --ink: #241e18;
    --muted: #5a4f44;
    --line: #e3d8c8;
    --brass-text: #84652f;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-sizing: border-box;
    width: 400px;
    margin-right: calc(var(--a) * -0.12);
    padding: 22px 24px 16px;
    border: 3px solid var(--brass);
    border-radius: 22px;
    background: var(--card);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    color: var(--ink);
    pointer-events: auto;
    transform-origin: right 30%;
    animation: bubble-in 0.55s 2s cubic-bezier(0.2, 0.9, 0.3, 1.15) both;
  }
  .bulle::before {
    content: "";
    position: absolute;
    right: -17px;
    top: calc(var(--a) * 0.34 - 18px);
    width: 26px;
    height: 26px;
    border: 3px solid var(--brass);
    border-left: 0;
    border-bottom: 0;
    background: var(--card);
    transform: rotate(45deg);
  }
  .bulle__peek {
    display: none;
  }

  /* Rangé : il file vers sa pastille, en bas à droite, et la bulle s'efface. */
  .accueil:global(.bye) .accueil__astro {
    animation: astro-dock 0.75s cubic-bezier(0.5, 0, 0.6, 1) forwards;
  }
  .accueil:global(.bye) .bulle {
    animation: bubble-out 0.3s ease-in forwards;
  }
  .accueil:global(.bye) .bulle__peek {
    animation: peek-dock 0.75s cubic-bezier(0.5, 0, 0.6, 1) forwards;
  }
  /* Rangé, il laisse l'anneau battre plus fort quelques secondes : c'est par là qu'on avance. */
  :global(.stop.nudge .ring::after) {
    animation-duration: 1.1s;
  }
  :global(.stop.nudge .lab) {
    border-color: var(--brass);
    background: var(--brass);
    color: var(--on-brass);
  }

  @keyframes astro-in {
    from {
      opacity: 0;
      transform: translate(220px, 160px) rotate(28deg) scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes astro-dock {
    to {
      opacity: 0;
      transform: translate(-30px, 240px) scale(0.2);
    }
  }
  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes bubble-out {
    to {
      opacity: 0;
      transform: scale(0.9);
    }
  }
  @keyframes peek-dock {
    to {
      opacity: 0;
      transform: translate(-200px, 330px) scale(0.3);
    }
  }

  /* Un écran d'ordinateur étroit ou bas : la bulle seule au-dessus du bouton retour, lui debout dessus (comme
     sur téléphone), pour laisser libres l'anneau de la Terre, plus haut, et le titre de l'escale, à gauche. */
  @media (min-width: 701px) and (max-width: 1199px), (min-width: 701px) and (max-height: 799px) {
    .accueil {
      right: 32px;
      bottom: 104px;
      display: block;
    }
    .accueil__astro {
      display: none;
    }
    .bulle {
      width: 420px;
      margin: 0;
      padding: 18px 20px 14px;
      gap: 8px;
      transform-origin: 80% bottom;
      animation-delay: 1.3s;
    }
    .bulle::before {
      display: none;
    }
    .bulle__peek {
      position: absolute;
      right: -12px;
      top: -118px;
      display: block;
      width: 140px;
      height: 140px;
      pointer-events: none;
      animation: astro-in 1.3s 1.5s cubic-bezier(0.2, 0.8, 0.25, 1) both;
    }
  }

  /* — Le téléphone : la bulle couvre le cartel, au-dessus de la barre du bas ; il se tient debout dessus — */
  @media (max-width: 700px) {
    .accueil {
      left: 16px;
      right: 16px;
      bottom: 96px;
      display: block;
    }
    .accueil__astro {
      display: none;
    }
    .bulle {
      width: auto;
      margin: 0;
      padding: 18px 18px 14px;
      gap: 8px;
      border-radius: 18px;
      transform-origin: center bottom;
      animation-delay: 1.3s;
    }
    .bulle::before {
      display: none;
    }
    .bulle__peek {
      position: absolute;
      right: -16px;
      top: -110px;
      display: block;
      width: 136px;
      height: 136px;
      pointer-events: none;
      animation: astro-in 1.3s 1.5s cubic-bezier(0.2, 0.8, 0.25, 1) both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accueil__astro,
    .bulle,
    .bulle__peek {
      animation: fade 0.3s both;
    }
    .accueil:global(.bye) .accueil__astro,
    .accueil:global(.bye) .bulle,
    .accueil:global(.bye) .bulle__peek {
      animation: fade 0.3s reverse both;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
