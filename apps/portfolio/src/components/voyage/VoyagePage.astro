---
/**
 * Le voyage, l'accueil du site : le départ, puis dix escales, une par projet. Chaque escale montre
 * sa scène (une boucle 3D précalculée), son cartel et l'objet à cliquer, qui mène à l'escale
 * suivante ; la dernière mène au carnet.
 *
 * Toutes les escales sont dans la page : sans script, elles se lisent à la suite, une par écran.
 * Avec le script (scripts/voyage.ts), une seule à la fois, et des transitions entre elles.
 * Sous 700 px, la disposition du téléphone : la scène recadrée en haut, le cartel dessous,
 * le retour et l'escale suivante au pouce.
 */
import { getProject } from "@index/projects";
import { appOf, fill, kindOf, START, STOP_TEXTS, STOPS, VOYAGE } from "../../data/voyage";
import { fichePath, LANGS, ROUTES, STRINGS, TABS, typo, type Lang } from "../../i18n/voyage";
import Voyage from "../../layouts/Voyage.astro";
import Copilote from "./Copilote.astro";
import CopiloteAccueil from "./CopiloteAccueil.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const v = VOYAGE[lang];
const t = STRINGS[lang];
const alternates = { fr: ROUTES.voyage.fr, en: ROUTES.voyage.en };

const stops = STOPS.map((stop, i) => {
  const project = getProject(stop.slug);
  if (!project) throw new Error(`Escale sans projet : ${stop.slug}`);
  return { ...stop, n: i + 1, project, text: STOP_TEXTS[lang][stop.slug]! };
});
const places = [v.start, ...stops.map((s) => s.text.place)];
---

<Voyage lang={lang} alternates={alternates} palette="night" background={START.bg}>
  <div
    class="voyage pal-night"
    data-voyage
    data-texts={JSON.stringify({ announce: v.announce })}
    style={`--bg: ${START.bg}`}
  >
    <!-- Avant même la mise en page : une escale à la fois, pour que les autres scènes ne se chargent pas. -->
    <script is:inline>
      document.currentScript.parentElement.classList.add("is-live");
    </script>
    <header class="vhead">
      <a class="brand" href={ROUTES.voyage[lang]} data-go="0" data-soft>
        <span class="brand__name">Index</span><span class="brand__who">Cantin Roquier</span>
      </a>
      <div class="vhead__end nav-desktop">
        <nav aria-label={t.tabsAria} class="tabs">
          {TABS.map((key) => <a href={ROUTES[key][lang]} aria-current={key === "voyage" ? "page" : undefined}>{t.tabs[key]}</a>)}
        </nav>
        <nav aria-label={t.langAria} class="tabs lang">
          {
            LANGS.map((l) => (
              <a
                href={l === lang ? undefined : alternates[l]}
                data-lang-link={l === lang ? undefined : alternates[l]}
                hreflang={l === lang ? undefined : l}
                lang={l}
                aria-label={t.langNames[l]}
                aria-current={l === lang ? "page" : undefined}
              >
                {l.toUpperCase()}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="vhead__end nav-phone">
        <nav aria-label={t.langAria} class="tabs lang">
          {
            LANGS.map((l) => (
              <a
                href={l === lang ? undefined : alternates[l]}
                data-lang-link={l === lang ? undefined : alternates[l]}
                hreflang={l === lang ? undefined : l}
                lang={l}
                aria-label={t.langNames[l]}
                aria-current={l === lang ? "page" : undefined}
              >
                {l.toUpperCase()}
              </a>
            ))
          }
        </nav>
        <details class="m-menu">
          <summary aria-label={t.menu}>
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </summary>
          <nav class="m-drop" aria-label={t.tabsAria}>
            {TABS.map((key) => <a href={ROUTES[key][lang]} aria-current={key === "voyage" ? "page" : undefined}>{t.tabs[key]}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="contenu">
      <section
        class="stop stop--intro"
        id="depart"
        data-stop="0"
        data-bg={START.bg}
        data-pal={START.palette}
        data-place={v.start}
        data-img-phone={`/voyage/${START.scene}-mobile.webp`}
        style={`--stop-bg: ${START.bg}`}
      >
        <div class="intro-scene">
          <video class="scene scene--video" muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true">
            <source src={`/voyage/${START.scene}-av1.mp4`} type='video/mp4; codecs="av01.0.12M.08"' />
            <source src={`/voyage/${START.scene}.mp4`} type='video/mp4; codecs="avc1.640034"' />
          </video>
          <picture>
            <source media="(max-width: 700px)" srcset={`/voyage/stills/${START.scene}-mobile.webp`} data-loop={`/voyage/${START.scene}-mobile.webp`} />
            <img class="scene scene--still" src={`/voyage/${START.scene}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="intro-shade" aria-hidden="true"></div>
        <div class="intro ui">
          <p class="label">{v.introLabel}</p>
          <h1 class="serif" tabindex="-1" data-focus set:html={v.introTitle} />
          <p class="intro__text">{typo(lang, v.introText)}</p>
          <div class="intro__actions">
            <a class="go" href="#escale-1" data-go="1">{v.takeOff}</a>
          </div>
        </div>
      </section>

      {
        stops.map((s) => {
          const app = appOf(s.project, s.text, lang);
          const last = s.n === stops.length;
          const next = last ? ROUTES.projets[lang] : `#escale-${s.n + 1}`;
          const prev = s.n === 1 ? "#depart" : `#escale-${s.n - 1}`;
          const left = s.spot[0] > 70;
          const style = [
            `--stop-bg: ${s.bg}`,
            `--x: ${s.spot[0]}%`,
            `--y: ${s.spot[1]}%`,
            `--mx: ${s.spotMobile[0]}%`,
            `--my: ${s.spotMobile[1]}%`,
            ...(s.tag ? [`--tx: ${s.tag[0]}%`, `--ty: ${s.tag[1]}%`] : []),
          ].join("; ");
          return (
            <section
              class={`stop pal-${s.palette}`}
              id={`escale-${s.n}`}
              aria-labelledby={`escale-${s.n}-titre`}
              data-stop={s.n}
              data-bg={s.bg}
              data-pal={s.palette}
              data-place={s.text.place}
              data-name={s.project.name}
              data-img-phone={`/voyage/${s.scene}-mobile.webp`}
              style={style}
            >
              <p class="visually-hidden">{s.text.alt}</p>
              <div class="scene-box">
                <video class="scene scene--video" muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true">
                  <source src={`/voyage/${s.scene}-av1.mp4`} type='video/mp4; codecs="av01.0.12M.08"' />
                  <source src={`/voyage/${s.scene}.mp4`} type='video/mp4; codecs="avc1.640034"' />
                </video>
                <picture>
                  <source media="(max-width: 700px)" srcset={`/voyage/stills/${s.scene}-mobile.webp`} data-loop={`/voyage/${s.scene}-mobile.webp`} />
                  <img class="scene scene--still" src={`/voyage/${s.scene}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
                </picture>
                <div class="poster-veil ui" aria-hidden="true" />
                <a class:list={["spot", { "spot--left": left }]} href={next} data-go={last ? undefined : s.n + 1}>
                  <span class="ring" aria-hidden="true" />
                  <span class="lab">
                    {s.text.cta}
                    <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
                {
                  s.tag && s.text.tag && (
                    <p class="tag ui">
                      <i aria-hidden="true" />
                      <span>{s.text.tag}</span>
                    </p>
                  )
                }
              </div>
              <article class="cartel ui">
                <p class="cartel__kind">
                  <span>{kindOf(s.project, s.text, lang).line}</span>
                </p>
                <h2 class="serif" id={`escale-${s.n}-titre`} tabindex="-1" data-focus>
                  {s.project.name}
                </h2>
                <p class="cartel__pitch">{typo(lang, s.text.pitch)}</p>
                {s.text.extra && <p class="cartel__extra">{typo(lang, s.text.extra)}</p>}
                <div class="cartel__links">
                  <a class="go" href={fichePath(lang, s.project)}>
                    <span class="lg">{v.fiche}</span>
                    <span class="sm">{v.ficheShort}</span>
                  </a>
                  {"href" in app ? (
                    <a class="link" href={app.href} target={app.target} rel={app.rel}>
                      <span class="lg">{app.label}</span>
                      <span class="sm">{app.short}</span>
                    </a>
                  ) : null}
                  {"note" in app && <span class="cartel__note">{app.note}</span>}
                </div>
              </article>
              {s.n === 1 && <CopiloteAccueil lang={lang} />}
              <nav class="stop-nav ui" aria-label={v.dotsAria}>
                <a class="back" href={prev} data-go={s.n - 1} data-soft aria-label={fill(v.backTo, { place: places[s.n - 1]! })}>
                  <span class="arrow" aria-hidden="true">←</span>
                  <span class="back__place" aria-hidden="true">
                    {places[s.n - 1]}
                  </span>
                </a>
                <p class="where" aria-hidden="true">
                  <span class="where__label">{fill(v.where, { i: s.n, n: stops.length, place: s.text.place })}</span>
                  <span class="where__dots">
                    {stops.map((o) => (
                      <i class:list={[{ done: o.n < s.n, now: o.n === s.n }]} />
                    ))}
                  </span>
                </p>
                <a class="go next" href={next} data-go={last ? undefined : s.n + 1}>
                  {s.text.cta}
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
                <Copilote lang={lang} n={s.n} scene={s.scene} />
              </nav>
            </section>
          );
        })
      }
    </main>

    <div class="veil" aria-hidden="true"></div>
    <p class="visually-hidden" aria-live="polite" data-announce></p>
  </div>
</Voyage>

<script>
  // Le copilote d'abord : il écoute le voyage dès sa première escale.
  import "../../scripts/copilote";
  import "../../scripts/voyage";
</script>

<style>
  /* Le voyage se regarde comme une affiche : ses textes ne se sélectionnent pas et la souris garde sa
     flèche (les liens et les boutons, eux, gardent leur main). Les fiches restent du texte à lire. */
  .voyage {
    position: relative;
    background: var(--bg);
    color: var(--ink);
    -webkit-user-select: none;
    user-select: none;
    cursor: default;
  }

  /* — L'en-tête : la marque à gauche, les onglets et la langue à droite — */
  .vhead {
    position: absolute;
    z-index: 3;
    left: 40px;
    right: 40px;
    top: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  /* — Une escale : sans script, une par écran, à la suite ; avec, une seule à la fois — */
  .stop {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--stop-bg);
    color: var(--ink);
  }
  :global(.voyage.is-live) {
    height: 100svh;
    overflow: hidden;
  }
  :global(.is-live) .stop {
    position: absolute;
    inset: 0;
    min-height: 0;
  }
  /* Le script du voyage montre l'escale courante. Avant lui, c'est le départ, ou l'escale de
     l'adresse (#escale-3) : les scènes cachées, chargées en différé, ne sont pas téléchargées. */
  :global(.is-live.is-ready .stop:not(.is-current)),
  :global(.is-live:not(.is-ready) .stop:not(:target):not(.stop--intro)),
  :global(.is-live:not(.is-ready):has(.stop:target) .stop--intro) {
    display: none;
  }

  /* La scène couvre l'écran sans se déformer ; l'anneau et l'étiquette sont placés en % de l'image. */
  .scene-box {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100%, 177.78svh);
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%);
  }
  .scene {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--x) var(--y);
    will-change: transform, opacity, filter;
  }
  /* Sur ordinateur, avec le script : la vidéo haute définition (2560 × 1440) remplace la boucle WebP,
     qui ne se télécharge alors pas. Sur téléphone et sans script : la boucle WebP. */
  .scene--video {
    display: none;
  }
  @media (min-width: 701px) {
    :global(.is-live) .scene--video {
      display: block;
    }
    :global(.is-live) .scene--still {
      display: none;
    }
    :global(.is-live) .stop:global(.no-video) .scene--video {
      display: none;
    }
    :global(.is-live) .stop:global(.no-video) .scene--still {
      display: block;
    }
  }

  .spot {
    position: absolute;
    z-index: 2;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
    transform: translate(-26px, -26px);
  }
  .spot--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 26px), -26px);
  }
  .ring {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 2px solid var(--brass);
    box-shadow: 0 0 0 5px var(--halo);
  }
  .ring::before {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--brass);
  }
  .ring::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 999px;
    border: 2px solid var(--brass);
    animation: sonar 2.4s ease-out infinite;
  }
  @keyframes sonar {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .lab {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .spot:hover .lab,
  .spot:focus-visible .lab {
    background: var(--ink);
    color: var(--card);
  }
  /* Sur ordinateur, la barre du bas dit déjà où mène l'objet : son étiquette n'apparaît qu'au survol. */
  @media (min-width: 701px) {
    .lab {
      opacity: 0;
      transition:
        opacity 0.2s,
        background 0.2s,
        color 0.2s;
    }
    .spot:hover .lab,
    .spot:focus-visible .lab {
      opacity: 1;
    }
  }
  /* Les flèches de la navigation, bien plus grandes que le texte qu'elles suivent ; elles avancent au survol. */
  .arrow {
    display: inline-block;
    font-size: 1.6em;
    line-height: 0.6;
    transition: transform 0.2s;
  }
  .lab .arrow,
  .next .arrow {
    margin-left: 0.3em;
  }
  .spot:hover .arrow,
  .spot:focus-visible .arrow,
  .next:hover .arrow {
    transform: translateX(3px);
  }
  .back:hover .arrow {
    transform: translateX(-3px);
  }

  .tag {
    position: absolute;
    left: var(--tx);
    top: var(--ty);
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    transform: translate(-7px, -7px);
  }
  .tag i {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--brass);
    box-shadow: 0 0 0 4px var(--halo);
  }
  .tag span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
  }

  /* — Le cartel, en bas à gauche : une affiche, le nom du projet en très grand à même la scène,
     sur un voile de la couleur de l'escale ; le retour, en bas à droite.
     L'affiche grandit avec l'écran, comme la scène : --u vaut 1px sur un écran de 1440 × 900. — */
  .stop {
    --u: clamp(0.72px, min(100vw / 1440, 100svh / 900), 2px);
  }
  /* Le voile est dans la scène, sous l'anneau ; il couvre le coin bas gauche de l'écran, pas de l'image. */
  .poster-veil {
    position: absolute;
    z-index: 1;
    left: calc(50% - 50vw);
    bottom: calc(50% - 50svh);
    width: 62vw;
    height: 66svh;
    background: radial-gradient(farthest-side at 0% 100%, var(--stop-bg) 0%, var(--stop-bg) 38%, transparent 100%);
    pointer-events: none;
  }
  /* Escale 1 : le cartel attend que le copilote ait fini son accueil (« Faire le voyage » ou la croix) ;
     scripts/copilote.ts le rend inerte d'ici là. Ses éléments seulement : le cartel lui-même porte
     l'animation d'arrivée de l'escale. */
  .cartel > * {
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .cartel[inert] > * {
    opacity: 0;
    transform: translateY(10px);
  }
  .cartel {
    position: absolute;
    z-index: 2;
    left: 40px;
    bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--u));
    width: min(calc(720 * var(--u)), calc(100% - 280px));
  }
  /* Sans carte, les petits textes reposent sur la couleur de l'escale : sur les escales claires, un laiton
     et un gris plus sombres que ceux des cartes (au moins 5:1 ; ceux des cartes tombaient à 3,2:1 sur Tonalli). */
  .stop:not(.pal-night) .cartel {
    --brass-text: #63491f;
    --muted: #574a3e;
  }
  .cartel__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: max(12px, calc(13 * var(--u)));
  }
  .cartel h2 {
    margin: 0;
    font-size: calc(116 * var(--u));
    line-height: 0.86;
    letter-spacing: -0.02em;
    text-wrap: balance;
    outline: none;
  }
  .cartel__pitch {
    max-width: calc(540 * var(--u));
    margin: 0;
    font-size: max(15px, calc(19 * var(--u)));
    line-height: 1.5;
  }
  .cartel__extra {
    max-width: calc(540 * var(--u));
    margin: 0;
    color: var(--muted);
    font-size: max(13px, calc(14 * var(--u)));
    line-height: 1.5;
  }
  .cartel__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px calc(22 * var(--u));
    padding-top: calc(6 * var(--u));
  }
  .cartel__links .go {
    min-height: max(48px, calc(52 * var(--u)));
    padding: 0 calc(26 * var(--u));
    font-size: max(15px, calc(16 * var(--u)));
  }
  .cartel__links .link {
    font-size: max(14px, calc(15 * var(--u)));
  }
  .cartel__note {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: max(12px, calc(12 * var(--u)));
  }
  .sm {
    display: none;
  }

  /* La barre des escales, en bas à droite, de nuit sur toutes les escales : reculer, où l'on en est,
     avancer, et le « ? » du copilote, qui rouvre le tuto. */
  .stop-nav {
    --dock: 48px;
    --ink: #f1e8da;
    --card: #1c2030;
    --line: #2b3040;
    --brass-text: #d9b475;
    position: absolute;
    z-index: 2;
    right: 40px;
    bottom: 30px;
    display: flex;
    align-items: stretch;
    gap: 4px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgba(14, 16, 24, 0.94);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    color: var(--ink);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .back:hover {
    background: var(--card);
  }
  .where {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin: 0;
    padding: 0 22px;
    border-inline: 1px solid var(--line);
  }
  .where__label {
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .where__dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .where__dots i {
    display: block;
    width: 6px;
    height: 6px;
    box-sizing: border-box;
    border: 1.5px solid #8a8274;
    border-radius: var(--radius-pill);
  }
  .where__dots i.done,
  .where__dots i.now {
    border-color: var(--brass);
    background: var(--brass);
  }
  .where__dots i.now {
    width: 10px;
    height: 10px;
  }
  .next {
    min-height: 48px;
    padding: 0 22px;
    font-size: 15px;
  }

  /* — Le départ : la planète à droite, le titre à gauche sur la nuit — */
  .intro-scene {
    position: absolute;
    left: 36%;
    top: 50%;
    width: 118%;
