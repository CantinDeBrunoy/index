---
/**
 * Le carnet de voyage, « Les projets » : le sommaire du voyage, de nuit, une carte postale par escale.
 * La carte ouvre la fiche du projet ; le lien du dessous rouvre son escale. Les projets racontés sur la
 * fiche d'un autre (l'API REST .NET, sur l'étagère de Mithril) sont nommés sur sa carte. Puis l'adresse où
 * m'écrire, et les crédits des modèles 3D des scènes.
 * En tête, le hub : une pastille par app, qui l'ouvre directement, avec son statut vérifié en direct
 * (scripts/app-status.ts, d'après /api/status). Sur téléphone, les pastilles défilent sur une ligne.
 * Les vignettes sont les images fixes des scènes (public/voyage/stills) : un carnet de cartes postales, et
 * une page légère, là où les dix boucles animées pèseraient près de 6 Mo. Les pastilles prennent l'image
 * du téléphone, cadrée sur l'objet de l'escale.
 * Sur grand écran (1 280 px et plus), la page s'élargit : le titre et les raccourcis côte à côte, puis les
 * escales en liste, et à côté la démo de celle qu'on a choisie, en grand, avec son accroche et ses liens
 * (scripts/carnet-scene.ts : l'image d'attente tout de suite, la vidéo si on s'y attarde ; sans démo, la scène).
 */
import { getProject, GITHUB_URL } from "@index/projects";
import { getEntry } from "astro:content";
import { APPS_ANCHOR, CARNET, CHIP_FOCUS } from "../../data/carnet";
import { CREDITS } from "../../data/credits";
import { FICHE, FICHE_OF, nameOf } from "../../data/fiches";
import { appOf, fill, kindOf, STOP_TEXTS, STOPS, VOYAGE } from "../../data/voyage";
import { EMAIL, fichePath, ROUTES, STRINGS, typo, type Lang } from "../../i18n/voyage";
import Voyage from "../../layouts/Voyage.astro";
import Badges from "./Badges.astro";
import Colophon from "./Colophon.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = CARNET[lang];
const f = FICHE[lang];
const alternates = { fr: ROUTES.projets.fr, en: ROUTES.projets.en };

const cards = STOPS.map((stop, i) => {
  const project = getProject(stop.slug)!;
  const text = STOP_TEXTS[lang][stop.slug]!;
  const shelved = Object.entries(FICHE_OF)
    .filter(([, host]) => host === stop.slug)
    .map(([slug]) => getProject(slug)!)
    .map((p) => `${p.number} ${nameOf(p, lang)}`);
  return { ...stop, n: i + 1, project, text, kind: kindOf(project, text, lang).line, shelved, app: appOf(project, text, lang) };
});
const still = (scene: string, size = "") => `/voyage/stills/${scene}${size}.webp`;
// La démo de chaque escale, celle de sa fiche (sa vidéo et son image d'attente) ; sans démo (Mithril), sa scène.
const demos = Object.fromEntries(
  await Promise.all(
    cards.map(async (s) => {
      const video = (await getEntry("projets", `${lang}/${s.slug}`))?.data.video;
      return [s.slug, video ? { src: video.src, poster: video.src.replace(/\.mp4$/, ".webp") } : undefined] as const;
    }),
  ),
);
const first = cards[0]!;
const firstDemo = demos[first.slug];
// Une vignette ronde, grossie puis recentrée sur l'objet de l'escale.
const focusOf = (scene: string) => {
  const { x, y, zoom } = CHIP_FOCUS[scene] ?? { x: 50, y: 50, zoom: 1.2 };
  return `transform: scale(${zoom}) translate(${50 - x}%, ${50 - y}%)`;
};

// Les raccourcis, dans l'ordre du voyage : chaque app qui s'ouvre ou se télécharge (ni les archives, ni ce site).
// Seules les apps sondées portent un point de statut.
const apps = cards.flatMap((s) => {
  const { app } = s;
  if (!("href" in app)) return [];
  return [{ ...s, app, focus: focusOf(s.scene), name: nameOf(s.project, lang), live: s.project.kind === "web" && s.project.monitors.length > 0 }];
});
// Les textes du statut, lus par le script dans la langue de la page.
const { states, checking, online, asleep, offline, checkedNow, checkedAgo, unavailable } = c;
const statusStrings = { states, checking, online, asleep, offline, checkedNow, checkedAgo, unavailable };
---

<Voyage lang={lang} title={c.pageTitle} description={c.description} alternates={alternates} palette="night">
  <SiteHeader lang={lang} current="projets" alternates={alternates} />
  <div class="wrap carnet">
    <main id="contenu">
      <div class="top">
      <section class="intro">
        <h1 class="serif" set:html={c.title} />
        <p class="intro__text">{typo(lang, c.intro)}</p>
      </section>

      {
        apps.length > 0 && (
          <section class="quick" id={APPS_ANCHOR} aria-label={c.quick} data-quick data-strings={JSON.stringify(statusStrings)}>
            <ul class="app-chips">
              {apps.map((a) => (
                <li>
                  <a class="app-chip" href={a.app.href} target={a.app.target} rel={a.app.rel}>
                    <span class="app-chip__img" style={`background: ${a.bg}`}>
                      <img src={still(a.scene, "-mobile")} alt="" width="780" height="760" decoding="async" style={a.focus} />
                    </span>
                    <span>{a.name}</span>
                    {a.live ? (
                      <>
                        <i class="live-dot" data-live={a.slug} data-state="pending" aria-hidden="true" />
                        <span class="visually-hidden" data-live-text>
                          , {c.states.pending}
                        </span>
                        <span class="app-chip__go" aria-hidden="true">
                          ↗
                        </span>
                      </>
                    ) : (
                      <span class="app-chip__go">{a.project.kind === "desktop" ? c.quickDownload : "↗"}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
            <p class="quick__status" aria-live="polite">
              <i class="live-dot" data-summary-dot data-state="pending" aria-hidden="true" />
              <span data-summary>{c.checking}</span>
              <span data-checked />
            </p>
            <p class="quick__owner" data-owner-note hidden>{c.owner}</p>
          </section>
        )
      }
      </div>

      <div class="atlas" data-atlas>
        <p id="atlas-hint" class="visually-hidden">{c.listHint}</p>
        <ol class="atlas__list" aria-label={c.listAria}>
          {
            cards.map((s, k) => (
              <li>
                <a
                  class="row"
                  href={fichePath(lang, s.project)}
                  data-atlas-row
                  data-bg={s.bg}
                  data-still={demos[s.slug]?.poster ?? still(s.scene)}
                  data-loop={demos[s.slug] ? undefined : `/voyage/${s.scene}.webp`}
                  data-demo={demos[s.slug]?.src}
                  data-on={k === 0 ? "" : undefined}
                  aria-current={k === 0 ? "true" : undefined}
                  aria-describedby="atlas-hint"
                >
                  <span class="row__num">{String(s.n).padStart(2, "0")}</span>
                  <span class="row__img" style={`background: ${s.bg}`}>
                    <img src={still(s.scene, "-mobile")} alt="" width="780" height="760" loading="lazy" decoding="async" style={focusOf(s.scene)} />
                  </span>
                  <span class="row__text">
                    <span class="serif row__name">{s.project.name}</span>
                    <span class="row__kind">{s.kind}</span>
                  </span>
                  {s.project.badges.length > 0 && (
                    <span class="row__badges">
                      <Badges project={s.project} lang={lang} />
                    </span>
                  )}
                </a>
              </li>
            ))
          }
        </ol>

        <section class="atlas__view" aria-label={c.previewAria}>
          <div class="atlas__media" data-atlas-media style={`background: ${first.bg}`}>
            <img src={firstDemo?.poster ?? still(first.scene)} alt="" width="1280" height="720" loading="lazy" decoding="async" />
            <video muted loop playsinline disablepictureinpicture preload="none" aria-hidden="true" tabindex="-1"></video>
          </div>
          <div class="atlas__panels" aria-live="polite">
            {
              cards.map((s, k) => (
                <div class="atlas__panel" data-atlas-panel data-off={k === 0 ? undefined : ""}>
                  <p class="atlas__stop">
                    {f.stop} {s.n} · {s.text.place}
                  </p>
                  <h2 class="serif atlas__name">{s.project.name}</h2>
                  <p class="atlas__kind">
                    <span>{s.kind}</span>
                    {s.project.badges.length > 0 && (
                      <span class="atlas__badges">
                        <Badges project={s.project} lang={lang} />
                      </span>
                    )}
                  </p>
                  <p class="atlas__pitch">{typo(lang, s.text.pitch)}</p>
                  <div class="atlas__links">
                    <a class="go" href={fichePath(lang, s.project)}>
                      {VOYAGE[lang].fiche}
                    </a>
                    {"href" in s.app && (
                      <a class="link" href={s.app.href} target={s.app.target} rel={s.app.rel}>
                        {s.app.label}
                      </a>
                    )}
                    <a class="link atlas__revisit" href={`${ROUTES.voyage[lang]}#escale-${s.n}`} aria-label={fill(c.revisitAria, { n: s.n, place: s.text.place })}>
                      {c.revisit}
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <ol class="cards">
        {
          cards.map((s) => (
            <li class="card">
              <a class="post" href={fichePath(lang, s.project)}>
                <span class="thumb" style={`background: ${s.bg}`}>
                  <img
                    src={still(s.scene, "-640")}
                    srcset={`${still(s.scene, "-640")} 640w, ${still(s.scene)} 1280w`}
                    sizes="(min-width: 1180px) 370px, (min-width: 760px) 50vw, 100vw"
                    alt=""
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="card__stop">
                  {f.stop} {s.n} · {s.text.place}
                </span>
                <span class="serif card__name">{s.project.name}</span>
                <span class="card__kind">{s.kind}</span>
                {
                  s.project.badges.length > 0 && (
                    <span class="card__badges">
                      <Badges project={s.project} lang={lang} />
                    </span>
                  )
                }
                {s.shelved.length > 0 && <span class="card__shelf">{typo(lang, fill(c.shelf, { list: s.shelved.join(", ") }))}</span>}
              </a>
              <a class="link card__revisit" href={`${ROUTES.voyage[lang]}#escale-${s.n}`} aria-label={fill(c.revisitAria, { n: s.n, place: s.text.place })}>
                {c.revisit}
              </a>
            </li>
          ))
        }
      </ol>

      <footer class="foot">
        <h2 class="serif" set:html={typo(lang, STRINGS[lang].nextIdea)} />
        <div class="foot__links">
          <a class="go" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a class="pill foot__github" href={GITHUB_URL} target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </footer>
      <p class="credits" set:html={typo(lang, CREDITS[lang])} />
    </main>
    <Colophon lang={lang} />
  </div>
</Voyage>

<script>
  import "../../scripts/app-status";
  import "../../scripts/carnet-scene";
</script>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
    padding: 56px 0 64px;
  }
  .intro h1 {
    margin: 0;
    font-size: clamp(56px, 7vw, 104px);
    line-height: 0.95;
  }
  .intro__text {
    margin: 0;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.6;
  }

  /* Les raccourcis : une pastille par app, qui l'ouvre directement ; son statut en direct, en point de couleur. */
  .quick {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: -24px 0 72px;
    scroll-margin-top: 24px;
  }
  .app-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* En position relative : le statut pour les lecteurs d'écran reste dans la pastille, et ne déborde pas de la ligne qui défile. */
  .app-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 5px 18px 5px 5px;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s;
  }
  .app-chip:hover {
    border-color: var(--brass);
  }
  .app-chip__img {
    flex: none;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: var(--radius-pill);
  }
  .app-chip__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .app-chip__go {
    color: var(--muted);
    font-size: 14px;
  }
  .live-dot {
    flex: none;
    width: 8px;
    height: 8px;
    box-sizing: border-box;
    border: 1.5px solid var(--muted);
    border-radius: var(--radius-pill);
  }
  .live-dot[data-state="online"] {
    border-color: var(--live-on);
    background: var(--live-on);
  }
  .live-dot[data-state="asleep"] {
    border-color: var(--live-asleep);
    background: var(--live-asleep);
  }
  .live-dot[data-state="offline"] {
    border-color: var(--live-off);
    background: var(--live-off);
  }
  /* En attente du statut, ou une app qui se réveille : le point respire. */
  .live-dot[data-state="pending"],
  .live-dot[data-state="asleep"] {
    animation: dot-wait 1.2s ease-in-out infinite;
  }
  @keyframes dot-wait {
    50% {
      opacity: 0.3;
    }
  }
  .quick__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .quick__owner {
    margin: 0;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .quick__status [data-checked]:not(:empty)::before {
    content: "·";
    margin-right: 10px;
  }

  /* Les cartes postales : trois de front sur ordinateur, deux sur tablette, une par ligne sur téléphone. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 48px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .card__stop {
    padding-top: 6px;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .card__name {
    font-size: 34px;
    line-height: 1;
  }
  .card__kind {
    color: var(--muted);
    font-size: 14px;
  }
  .card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .card__shelf {
    color: var(--muted);
    font-size: 13px;
  }
  .card__revisit {
    align-self: flex-start;
  }

  /* — Sur grand écran : la liste des escales, et la scène de celle qu'on a choisie d'un clic — */
  .atlas {
    display: none;
  }
  .atlas__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .atlas__list li {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 36px 64px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 12px 16px;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s;
  }
  .row[data-on] {
    background: var(--card);
  }
  /* Le survol ne change plus la scène : il montre seulement que la ligne se choisit d'un clic. */
  .row:not([data-on]):hover {
    background: color-mix(in srgb, var(--card) 55%, transparent);
  }
  .row__num {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .row[data-on] .row__num {
    color: var(--brass-text);
  }
  .row__img {
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: var(--radius-pill);
  }
  .row__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .row__name {
    font-size: 30px;
    line-height: 1.05;
  }
  .row__kind {
    color: var(--muted);
    font-size: 14px;
  }
  .row__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .atlas__view {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
  }
  .atlas__media {
    position: relative;
    aspect-ratio: 16 / 9;
    transition: background 0.3s;
  }
  .atlas__media img,
  .atlas__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* La démo se pose sur son image d'attente, une fois qu'elle joue (scripts/carnet-scene.ts). */
  .atlas__media video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .atlas__media video.is-on {
    opacity: 1;
  }
  /* Les textes des dix escales, superposés : le plus long donne la hauteur, rien ne saute d'une escale à
     l'autre. Sous la scène, l'essentiel seulement : le lieu, le nom, le type, deux lignes d'accroche, les liens. */
  .atlas__panels {
    display: grid;
    padding: 20px 28px 24px;
  }
  .atlas__panel {
    display: flex;
    grid-area: 1 / 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .atlas__panel[data-off] {
    visibility: hidden;
  }
  .atlas__badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .atlas__stop {
    margin: 0;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .atlas__name {
    margin: 0;
    font-size: clamp(34px, 2.4vw, 46px);
    line-height: 1;
  }
  .atlas__kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }
  .atlas__pitch {
    display: -webkit-box;
    margin: 2px 0 0;
    overflow: hidden;
    font-size: 16px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .atlas__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
    margin-top: 6px;
  }
  .atlas__links .go {
    min-height: 44px;
    padding: 0 20px;
    font-size: 15px;
  }
  .atlas__revisit {
    color: var(--muted);
  }

  @media (min-width: 1280px) {
    .carnet {
      max-width: 1840px;
    }
    .top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: end;
      padding-bottom: 64px;
    }
    .top .intro {
      padding-bottom: 0;
    }
    .top .quick {
      margin: 0;
    }
    .atlas {
      display: grid;
      grid-template-columns: minmax(440px, 0.85fr) minmax(0, 1fr);
      gap: 64px;
    }
    /* La liste défile dans la hauteur de la scène, au lieu de pousser la page : sans taille propre (contain), elle
       prend celle de la rangée, que donne la scène. Sa barre de défilement, fine et en laiton, montre qu'il y a la
       suite ; une marge la décolle des lignes. */
    .atlas__list {
      contain: size;
      overflow-y: auto;
      padding-right: 18px;
      scrollbar-width: thin;
      scrollbar-color: var(--brass) color-mix(in srgb, var(--brass) 16%, transparent);
    }
    /* Safari ne connaît pas scrollbar-color : la même barre, en pseudo-éléments. */
    @supports not (scrollbar-color: auto) {
      .atlas__list::-webkit-scrollbar {
        width: 6px;
      }
      .atlas__list::-webkit-scrollbar-track {
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--brass) 16%, transparent);
      }
      .atlas__list::-webkit-scrollbar-thumb {
        border-radius: var(--radius-pill);
        background: var(--brass);
      }
    }
    .cards {
      display: none;
    }
  }
  /* Entre 1 280 et 1 600 px, la liste est étroite : ses pastilles laissent la place au type du projet, et
     restent sur la scène, à côté. */
  @media (min-width: 1280px) and (max-width: 1599px) {
    .row .row__badges {
      display: none;
    }
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: 112px;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }
  .foot h2 {
    max-width: 640px;
    margin: 0;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1;
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .foot__github {
    min-height: 52px;
  }

  .credits {
    margin: 40px 0 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
