---
/**
 * « Au travail », dans « À propos » : un magasin en coupe, un point par app faite à la STIME ; à côté, la tournée
 * d'un camion de livraison sur une route en serpent, un feu par app dans l'ordre où Cantin les a faites ; dessous,
 * la fiche de l'app choisie, en deux colonnes, comme un point de fiche projet. Un point, un feu ou précédent /
 * suivant choisit l'app : le camion suit la route jusqu'à son feu, qui passe au rouge, et ceux d'avant au vert
 * (scripts/travail.ts). Les fiches sont superposées : la hauteur reste celle de la plus longue. Sans script, la
 * tournée disparaît et les quatre fiches se lisent à la suite.
 * Textes et points : data/travail.ts ; la scène : design/renders/magasin-scenes.js.
 */
import { ORDER, SPOTS, TRAVAIL } from "../../data/travail";
import { typo, type Lang } from "../../i18n/voyage";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = TRAVAIL[lang];
const T = (text: string) => typo(lang, text);
const items = ORDER.map((id, i) => ({ id, i, n: i + 1, nn: String(i + 1).padStart(2, "0"), spot: SPOTS[id], ...t.projets[id] }));
const LAST = items.length - 1;
const ARROW = { prev: "M19 12H5M11 18l-6-6 6-6", next: "M5 12h14M13 6l6 6-6 6" };
const still = (name: string) => `/voyage/stills/${name}.webp`;

// La route en serpent, dans une boîte de 360 × 370 où le SVG, les feux et le camion se placent en % : quatre rangs
// reliés par des demi-cercles de 45, un feu au milieu de chacun (x 200). Les rangs 1 et 3 vont vers la droite, 2 et
// 4 vers la gauche.
const BOX = { w: 360, h: 370 };
const ROAD = "M 40 60 H 300 A 45 45 0 0 1 300 150 H 60 A 45 45 0 0 0 60 240 H 300 A 45 45 0 0 1 300 330 H 40";
const ROWS = [60, 150, 240, 330];
const STOP_X = 200;
const ARC = Math.PI * 45;
const LENGTH = 260 + 240 + 240 + 260 + 3 * ARC;
/** Où tombe chaque feu sur la route, en % de sa longueur (le tracé du trajet fait, et le camion pour le script). */
const AT = [160, 260 + ARC + 100, 260 + 240 + 2 * ARC + 140, 260 + 2 * 240 + 3 * ARC + 100].map((d) => (d / LENGTH) * 100);
/** Le camion se gare à 40 de son feu, avant lui dans le sens de la route. */
const PARK = 40;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const rightward = LAST % 2 === 0;
const truck = `left: ${pct(STOP_X + (rightward ? -PARK : PARK), BOX.w)}; top: ${pct(ROWS[LAST]!, BOX.h)}; --flip: ${rightward ? 1 : -1}`;
const groups = t.groups.map((g) => g.split(" · "));
---

<div class="travail" data-travail>
  <script is:inline>document.currentScript.parentElement.classList.add("js");</script>
  <p class="travail__lead">{T(t.lead)}</p>

  <div class="top">
    <div class="shop">
      <picture>
        <source media="(max-width: 700px) and (prefers-reduced-motion: reduce)" srcset={still("magasin-mobile")} width="780" height="760" />
        <source media="(max-width: 700px)" srcset="/voyage/magasin-mobile.webp" width="780" height="760" />
        <source media="(prefers-reduced-motion: reduce)" srcset={still("magasin")} />
        <img src="/voyage/magasin.webp" alt={t.alt} width="1280" height="720" loading="lazy" decoding="async" />
      </picture>
      {
        items.map((p) => (
          <button
            type="button"
            class:list={["spot", `spot--${p.spot.side}`, { on: p.i === LAST }]}
            style={`--x: ${p.spot.desk[0]}%; --y: ${p.spot.desk[1]}%; --mx: ${p.spot.phone[0]}%; --my: ${p.spot.phone[1]}%`}
            data-pick={p.i}
            aria-pressed={p.i === LAST ? "true" : "false"}
            aria-label={`${p.n}. ${p.lieu}, ${p.titre}`}
          >
            <span class="ring" aria-hidden="true" />
            <span class="spot__num" aria-hidden="true">
              {p.n}
            </span>
            <span class="spot__label" aria-hidden="true">
              {p.n} · {p.lieu}
            </span>
          </button>
        ))
      }
    </div>

    <div class="snake">
      <div class="snake__box">
        <svg class="snake__road" viewBox={`0 0 ${BOX.w} ${BOX.h}`} aria-hidden="true">
          <path class="snake__band" d={ROAD} data-road />
          <path class="snake__dash" d={ROAD} />
          <path class="snake__trail" d={ROAD} pathLength="100" style={`stroke-dashoffset: ${(100 - AT[LAST]!).toFixed(3)}`} data-trail />
        </svg>
        <p class="snake__group" style={`left: ${pct(44, BOX.w)}; top: ${pct(4, BOX.h)}`}>
          {groups[0]![0]}
          <br />
          {groups[0]![1]}
        </p>
        <p class="snake__group" style={`left: ${pct(70, BOX.w)}; top: ${pct(178, BOX.h)}`}>
          {groups[1]![0]}
          <br />
          {groups[1]![1]}
        </p>
        <svg class="snake__truck" viewBox="0 0 46 30" style={truck} data-truck aria-hidden="true">
          <rect x="1" y="2" width="27" height="19" rx="3" fill="currentColor" />
          <rect x="5" y="7" width="19" height="2.5" rx="1.25" fill="#f6f1e9" opacity="0.7" />
          <path d="M29 8h8.5l6.5 6.5V21H29z" fill="currentColor" />
          <path d="M32 10.5h4.6l4 4H32z" fill="#f6f1e9" />
          <circle cx="10" cy="23" r="5" fill="#241e18" />
          <circle cx="10" cy="23" r="1.8" fill="#f6f1e9" />
          <circle cx="36" cy="23" r="5" fill="#241e18" />
          <circle cx="36" cy="23" r="1.8" fill="#f6f1e9" />
        </svg>
        <div role="group" aria-label={t.stops}>
          {
            items.map((p) => (
              <button
                type="button"
                class:list={["feu", { on: p.i === LAST, done: p.i < LAST }]}
                style={`left: ${pct(STOP_X, BOX.w)}; top: ${pct(ROWS[p.i]! - 7, BOX.h)}`}
                data-pick={p.i}
                data-at={AT[p.i]!.toFixed(3)}
                aria-pressed={p.i === LAST ? "true" : "false"}
                aria-label={`${p.nn} · ${p.groupe} · ${p.titre}`}
              >
                <svg class="feu__svg" viewBox="0 0 18 46" aria-hidden="true">
                  <circle class="feu__halo" cx="9" cy="9" r="13" />
                  <rect class="feu__boite" x="1" y="1" width="16" height="34" rx="5" />
                  <circle class="feu__lampe feu__rouge" cx="9" cy="8" r="4.2" />
                  <circle class="feu__lampe feu__orange" cx="9" cy="18" r="4.2" />
                  <circle class="feu__lampe feu__vert" cx="9" cy="28" r="4.2" />
                  <rect class="feu__boite" x="7.5" y="35" width="3" height="11" />
                </svg>
                <span class="feu__name" aria-hidden="true">
                  <b>{p.nn}</b>
                  {p.court}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="body">
    <p class="visually-hidden" aria-live="polite" data-status></p>
    <div class="panels">
      {
        items.map((p) => (
          <article class="panel" data-panel={p.i} data-title={`${p.n} / ${items.length} · ${p.titre}`} data-off={p.i === LAST ? undefined : ""}>
            <div class="panel__head">
              <div>
                <p class="panel__kicker">
                  {p.nn} · {p.groupe} · {p.lieu}
                </p>
                <h3 class="serif panel__title">{p.titre}</h3>
              </div>
              {
                p.chiffre && (
                  <p class="panel__big">
                    <b class="serif">{p.chiffre}</b>
                    <span>{T(p.chiffreLabel)}</span>
                  </p>
                )
              }
              <p class="panel__meta">
                {p.quand} · {p.role}
                <br />
                {p.equipe}
              </p>
              <ul class="chips">
                {p.outils.map((o) => (
                  <li class="chip">{o}</li>
                ))}
              </ul>
            </div>
            <div class="panel__text">
              <p>{T(p.quoi)}</p>
              <p>{T(p.moi)}</p>
              {p.resultat && <p>{T(p.resultat)}</p>}
            </div>
          </article>
        ))
      }
    </div>
    <div class="body__nav">
      <button type="button" class="body__btn" data-step="-1" aria-label={t.prev}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={ARROW.prev} />
        </svg>
      </button>
      <span class="body__pos" aria-hidden="true">
        <span data-pos>{items.length}</span> / {items.length}
      </span>
      <button type="button" class="body__btn" data-step="1" aria-label={t.next}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={ARROW.next} />
        </svg>
      </button>
    </div>
  </div>

  <p class="travail__note">{T(t.note)}</p>
</div>

<script>
  import "../../scripts/travail";
</script>

<style>
  .travail__lead {
    max-width: 760px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }
  .travail button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  /* — La scène : le magasin en coupe, ses quatre points (l'anneau et l'étiquette du voyage) — */
  /* En haut : la scène à gauche, la tournée à droite, à peu près de la même hauteur ; l'une sous l'autre sous 1000 px. */
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.82fr) minmax(0, 1fr);
    align-items: start;
    gap: 28px;
    margin-top: 36px;
  }
  .shop {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 24px;
    background: #f0e2da;
  }
  .shop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .spot {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translate(-26px, -26px);
  }
  .spot--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 26px), -26px);
  }
  .ring {
    position: relative;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 2px solid var(--brass);
    border-radius: var(--radius-pill);
    background: rgba(251, 247, 240, 0.35);
    box-shadow: 0 0 0 5px var(--halo);
  }
  .ring::before {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--brass);
  }
  .ring::after {
    content: "";
    position: absolute;
    inset: -2px;
    border: 2px solid var(--brass);
    border-radius: var(--radius-pill);
    animation: sonar 2.4s ease-out infinite;
  }
  @keyframes sonar {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .spot.on .ring {
    background: var(--brass);
  }
  .spot.on .ring::before {
    background: var(--card);
  }
  .spot__label {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--card);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .spot:hover .spot__label,
  .spot.on .spot__label {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--card);
  }
  .spot__num {
    display: none;
  }

  /* — La tournée : une route en serpent sur le rosé du plan de ligne, un feu par app, le trajet fait en laiton, le
     camion garé juste avant le feu de l'app choisie. La boîte garde les proportions du dessin (360 × 370) : le SVG,
     les feux et le camion s'y placent en %. Le feu choisi est rouge, ceux d'avant verts, les autres éteints. — */
  .snake {
    display: flex;
    justify-content: center;
    padding: 24px;
    border-radius: 22px;
    background: #f0e3cc;
  }
  .snake__box {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 360 / 370;
  }
  .snake__road {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .snake__band,
  .snake__dash,
  .snake__trail {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snake__band {
    stroke: #e2cdaa;
    stroke-width: 14;
  }
  .snake__dash {
    stroke: rgba(251, 247, 240, 0.95);
    stroke-width: 2;
    stroke-dasharray: 12 16;
  }
  .snake__trail {
    stroke: var(--brass);
    stroke-width: 4;
    stroke-dasharray: 100 100;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.5, 0, 0.2, 1);
  }
  .snake__group {
    position: absolute;
    margin: 0;
    color: #63491f;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .snake__truck {
    position: absolute;
    width: 46px;
    height: 30px;
    color: var(--brass);
    transform: translate(-50%, -85%) scaleX(var(--flip, 1));
    animation: moteur 0.5s ease-in-out infinite;
  }
  @keyframes moteur {
    50% {
      translate: 0 -1px;
    }
  }
  /* Un feu : son pied posé au bord de la route, au point du rang ; son nom à droite. */
  .feu {
    position: absolute;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 44px;
    height: 50px;
    margin: -50px 0 0 -22px;
  }
  .feu__svg {
    display: block;
    width: 18px;
    height: 46px;
    overflow: visible;
    transform-origin: 50% 100%;
    transition: transform 0.25s;
  }
  .feu__boite {
    fill: #2b2b2f;
  }
  .feu__lampe {
    fill: #55565d;
    transition: fill 0.25s;
  }
  .feu__halo {
    fill: #e5483d;
    opacity: 0;
  }
  .feu.done .feu__vert {
    fill: #5cbf6a;
  }
  .feu:hover:not(.on) .feu__orange {
    fill: #f0b44a;
  }
  .feu.on .feu__svg {
    transform: scale(1.15);
  }
  .feu.on .feu__rouge {
    fill: #e5483d;
  }
  .feu.on .feu__halo {
    animation: rouge 2.4s ease-in-out infinite;
  }
  @keyframes rouge {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 0.45;
    }
  }
  .feu__name {
    position: absolute;
    top: 12px;
    left: calc(100% - 6px);
    display: flex;
    align-items: baseline;
    gap: 6px;
    color: #574a3e;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }
  .feu__name b {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
  }
  .feu.on .feu__name {
    color: var(--ink);
  }
  .feu.on .feu__name b {
    color: #63491f;
  }

  /* — La fiche de l'app choisie : deux colonnes, comme un point de fiche projet ; les fiches superposées — */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    column-gap: 64px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .panels {
    grid-column: 1 / -1;
  }
  .panel {
    display: grid;
    grid-template-columns: subgrid;
    align-content: start;
    align-items: start;
  }
  .panel + .panel {
    margin-top: 56px;
  }
  .panel__head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .panel__kicker {
    margin: 0 0 14px;
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .panel__title {
    margin: 0;
    font-size: clamp(36px, 3.8vw, 52px);
    line-height: 1.02;
  }
  .panel__big {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
  }
  .panel__big b {
    font-size: 52px;
    line-height: 1;
    white-space: nowrap;
  }
  .panel__big span {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }
  .panel__meta {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
  }
  .panel__text {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .panel__text p {
    margin: 0;
    font-size: 20px;
    line-height: 1.6;
  }
  .body__nav {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }
  .travail .body__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1.5px solid var(--brass);
    border-radius: var(--radius-pill);
    background: var(--card);
    color: var(--ink);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .travail .body__btn:hover {
    background: var(--ink);
    color: var(--card);
  }
  .body__pos {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .travail__note {
    margin: 32px 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Avec le script : les fiches dans la même case, la plus haute donne la hauteur. Sans : la tournée et les
     boutons disparaissent, les fiches se lisent à la suite. */
  .travail:global(.js) .panels {
    display: grid;
    grid-template-columns: subgrid;
  }
  .travail:global(.js) .panel {
    grid-area: 1 / 1 / 2 / -1;
  }
  .travail:global(.js) .panel + .panel {
    margin-top: 0;
  }
  .travail:global(.js) .panel[data-off] {
    visibility: hidden;
  }
  .travail:not(:global(.js)) .snake,
  .travail:not(:global(.js)) .body__nav {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ring::after {
      animation: none;
      opacity: 0;
    }
    .snake__truck,
    .feu.on .feu__halo {
      animation: none;
    }
    .feu.on .feu__halo {
      opacity: 0.3;
    }
    .snake__trail,
    .feu__svg,
    .feu__lampe {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Sur téléphone : la scène carrée du téléphone et des numéros à la place des étiquettes ; la tournée plus serrée ;
     la fiche en une colonne. */
  @media (max-width: 700px) {
    .top {
      gap: 16px;
      margin-top: 28px;
    }
    .shop {
      aspect-ratio: 780 / 760;
      border-radius: 18px;
    }
    .spot,
    .spot--left {
      top: var(--my);
      left: var(--mx);
      justify-content: center;
      width: 44px;
      height: 44px;
      transform: translate(-22px, -22px);
    }
    .ring,
    .spot__label {
      display: none;
    }
    .spot__num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      box-sizing: border-box;
      border: 2px solid var(--brass);
      border-radius: var(--radius-pill);
      background: var(--card);
      box-shadow: 0 0 0 5px var(--halo);
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 500;
    }
    .spot.on .spot__num {
      background: var(--brass);
      color: var(--on-brass);
    }
    .snake {
      padding: 16px;
      border-radius: 18px;
    }
    .snake__truck {
      width: 37px;
      height: 24px;
    }
    .body {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 28px;
      padding-top: 28px;
    }
    .panel__head {
      gap: 16px;
    }
    .panel__text {
      margin-top: 18px;
    }
    .panel__text p {
      font-size: 17px;
    }
    .panel__big b {
      font-size: 44px;
    }
    .body__nav {
      grid-column: 1;
    }
  }
</style>
