---
/**
 * La carte d'embarquement d'une fiche, à côté de la démo. La forme d'une carte (le bandeau à l'encre de nuit,
 * le talon détaché par une ligne pointillée et deux encoches), mais ce sont les infos qui comptent : avec quoi
 * c'est fait, où ça tourne, et sur le talon le statut de l'app en direct (ou pourquoi il n'y en a pas). Ni l'app
 * ni le code : l'en-tête de la fiche les ouvre déjà. Le trajet d'Index vers le projet reste en petit dans le
 * bandeau. `compact` : la version posée à droite de la démo ; `level` : le niveau du titre, 3 sous la démo, 2
 * quand la carte est seule.
 */
import type { Project } from "@index/projects";
import { FICHE } from "../../data/fiches";
import { appOf, kindOf, STOPS, type Stop, type StopText } from "../../data/voyage";
import type { Lang } from "../../i18n/voyage";

interface Props {
  lang: Lang;
  project: Project;
  stop: Stop;
  text: StopText;
  compact?: boolean;
  level?: 2 | 3;
}

const { lang, project, stop, text, compact = false, level = 3 } = Astro.props;
const p = FICHE[lang].pass;
const app = appOf(project, text, lang);
const status = kindOf(project, text, lang).status;
// Seule une app web en ligne a un statut en direct (sondé par le Worker, /api/status).
const live = project.kind === "web" && "href" in app;
const HOME_CODE = STOPS.find((s) => s.slug === "index")!.code;
const Title = level === 2 ? "h2" : "h3";
const titleId = `carte-${project.slug}`;
---

<aside class:list={["pass", { "pass--compact": compact }]} aria-labelledby={titleId}>
  <div class="pass__paper">
    <div class="pass__band pal-night">
      <Title id={titleId} class="pass__title">{p.title}</Title>
      <span class="pass__route" aria-hidden="true">
        {HOME_CODE}
        <svg width="12" height="12" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M3.5 12c0-1 1-1.2 2.5-1.2h13c1.4 0 2.2.6 2.2 1.2s-.8 1.2-2.2 1.2H6c-1.5 0-2.5-.2-2.5-1.2zM10.5 10.8 8 3.5h2l5 7.3zM10.5 13.2 8 20.5h2l5-7.3zM4.6 10.8 3.4 7.5h1.2l2.2 3.3zM4.6 13.2l-1.2 3.3h1.2l2.2-3.3z"
          ></path>
        </svg>
        {stop.code}
      </span>
    </div>
    <div class="pass__body">
      <dl class="pass__facts">
        <div>
          <dt>{p.madeWith}</dt>
          <dd><ul class="chips">{project.stack.map((tech) => <li class="chip">{tech}</li>)}</ul></dd>
        </div>
        {
          project.host && (
            <div>
              <dt>{p.host}</dt>
              <dd>{project.host}</dd>
            </div>
          )
        }
      </dl>
    </div>
    {
      "href" in app ? (
        <p class="pass__gate">
          <span class="pass__gate-label">{p.status}</span>
          <span class="pass__status" data-brief-live={live ? project.slug : undefined} data-states={live ? JSON.stringify(p.states) : undefined}>
            {live && <i class="live-dot" data-state="pending" aria-hidden="true" hidden />}
            <span data-live-text>{status}</span>
          </span>
        </p>
      ) : (
        <p class="pass__gate pass__gate--off">{app.note}</p>
      )
    }
  </div>
</aside>

<script>
  import "../../scripts/brief-status";
</script>

<style>
  .pass {
    flex: 0 1 400px;
    align-self: flex-start;
    filter: drop-shadow(0 1px 0 rgba(36, 30, 24, 0.14)) drop-shadow(0 22px 30px rgba(20, 14, 8, 0.16));
    /* Les couleurs du statut, plus sombres que celles du carnet de nuit : elles tiennent sur le papier. */
    --live-on: #4f8a4c;
    --live-asleep: #a8741c;
    --live-off: #b4553f;
  }
  .pass__paper {
    --gate: 64px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--card);
    /* Les encoches : un demi-cercle découpé de chaque côté de la ligne pointillée. */
    mask:
      radial-gradient(circle at 0 calc(100% - var(--gate)), transparent 12px, #000 12.5px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% calc(100% - var(--gate)), transparent 12px, #000 12.5px) right / 51% 100% no-repeat;
  }
  /* Le bandeau : le titre, et le trajet en petit. */
  .pass__band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 36px;
    padding: 0 22px;
    background: var(--card);
    color: var(--brass-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pass__title {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }
  .pass__route {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .pass__body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 24px 20px;
  }
  .pass__facts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
  }
  .pass__facts dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pass__facts dd {
    margin: 6px 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }
  .pass__facts .chips {
    margin-top: 10px;
  }
  /* Le talon : le statut de l'app, et rien d'autre. */
  .pass__gate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    box-sizing: border-box;
    height: var(--gate);
    margin: 0;
    padding: 0 24px;
    border-top: 2px dashed rgba(36, 30, 24, 0.3);
    background: var(--paper);
    color: var(--ink);
    font-size: 17px;
    font-weight: 600;
  }
  .pass__gate-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pass__status {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pass__gate--off {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }

  /* La version posée à droite de la démo : un peu plus serrée. */
  .pass--compact {
    flex: none;
    width: 100%;
    max-width: 340px;
  }
  .pass--compact .pass__paper {
    --gate: 58px;
  }
  .pass--compact .pass__band {
    min-height: 32px;
    padding: 0 18px;
    font-size: 10px;
  }
  .pass--compact .pass__body {
    gap: 16px;
    padding: 18px 20px 18px;
  }
  .pass--compact .pass__facts {
    gap: 14px;
  }
  .pass--compact .pass__facts dd {
    font-size: 15px;
  }
  .pass--compact .chip {
    min-height: 28px;
    padding: 0 11px;
    font-size: 12px;
  }
  .pass--compact .pass__gate {
    padding: 0 18px;
    font-size: 16px;
  }

  /* Le point du statut en direct, comme dans le carnet. */
  .live-dot {
    flex: none;
    width: 9px;
    height: 9px;
    box-sizing: border-box;
    border: 1.5px solid var(--muted);
    border-radius: var(--radius-pill);
  }
  .live-dot[hidden] {
    display: none;
  }
  .live-dot[data-state="online"] {
    border-color: var(--live-on);
    background: var(--live-on);
  }
  .live-dot[data-state="asleep"] {
    border-color: var(--live-asleep);
    background: var(--live-asleep);
  }
  .live-dot[data-state="offline"] {
    border-color: var(--live-off);
    background: var(--live-off);
  }
  /* En attente du statut, ou une app qui se réveille : le point respire. */
  .live-dot[data-state="pending"],
  .live-dot[data-state="asleep"] {
    animation: dot-wait 1.2s ease-in-out infinite;
  }
  @keyframes dot-wait {
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none !important;
    }
  }
</style>
