{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "index",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Les sondes visent aussi Magellan et gym-picker, d'autres Workers du même workers.dev : sans ce
  // drapeau, Cloudflare refuse un fetch d'un Worker vers un autre de la même zone (erreur 1042).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    // Le site (build Astro) est servi directement ; passent par le Worker /api/* et les vidéos, qu'il
    // sert par morceaux (requêtes Range, sans quoi Safari ne les lit pas).
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/demos/*.mp4", "/voyage/*.mp4"],
    "not_found_handling": "404-page"
  },
  // Keep-alive : les sondes de keep-alive.yml, chaque heure, sans dépendre des crons de GitHub.
  "triggers": { "crons": ["47 * * * *"] },
  // Secrets facultatifs (local : .dev.vars ; production : pnpm exec wrangler secret put <NOM>) :
  // - TONALLI_SUPABASE_ANON_KEY : sonde aussi la base Supabase de Tonalli (et la garde éveillée) ;
  // - GITHUB_ALERTS_TOKEN : ouvre et ferme les issues d'alerte sur CantinDeBrunoy/index ;
  // - GITHUB_CLIENT_SECRET et SESSION_SECRET : la connexion du propriétaire (/api/auth/*), avec
  //   GITHUB_CLIENT_ID ci-dessous. Magellan et Hublot la vérifient auprès de ce Worker (liaison HUB).
  "vars": {
    // L'identifiant de l'application OAuth GitHub « INDEX » : public, il figure dans l'adresse de connexion.
    "GITHUB_CLIENT_ID": ""
  },
  "observability": { "enabled": true }
}
