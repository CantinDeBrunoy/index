{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "index",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Le site (build Astro) est servi directement ; seul /api/* passe par le Worker.
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Optionnel : clé anon Supabase de Tonalli, pour que le statut live sonde aussi la base.
  // Local : fichier .dev.vars. Production : pnpm exec wrangler secret put TONALLI_SUPABASE_ANON_KEY
  "observability": { "enabled": true }
}
