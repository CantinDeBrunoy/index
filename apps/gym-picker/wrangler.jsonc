{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gym-picker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    // La page (build Vite) est servie directement ; seul /api/* passe par le Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Local : fichier .dev.vars. Production : npx wrangler secret put TOMTOM_API_KEY
  "secrets": { "required": ["TOMTOM_API_KEY"] },
  // L'URL est publique : on borne les appels par IP pour protéger le quota
  // TomTom (2 500 requêtes/jour). 20 par minute, c'est large pour un humain.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
